<?xml version="1.0"?>
<assets base_path="assets/">

	<!-- ///MCSHAY MISC\\\ -->
	<!-- Registration only, at mod init: this creates the DB entries that make the mod's
	     files win over the base game's. It must happen at boot - a scripted group only
	     registers when it is loaded, which is during GameSetup:load_packages, by which
	     point the level's own packages have already resolved the base-game files and the
	     overrides do nothing.

	     Nothing is dyn-loaded from here (dyn_package="false"). Which units get handed to
	     dyn_resource, and for which faction, is driven from lua/sc/superblt_units.lua,
	     which loads each dbpath exactly once - handing the same one over twice leaves a
	     load that never completes and hangs the level on a black screen. -->
	<group dyn_package="false">

		<group name="units/payday2/characters/ene_acc_shield_city/">
		</group>

		<group name="units/pd2_mod_nypd/characters/ene_bulldozer_1/">
		</group>

		<group name="units/pd2_mod_nypd/characters/ene_bulldozer_1/debris/ene_acc_bulldozer_helmet_plate/">
		</group>

		<group name="units/pd2_mod_nypd/characters/ene_bulldozer_1/debris/ene_acc_bulldozer_neck/">
		</group>

		<group name="units/pd2_mod_nypd/characters/ene_bulldozer_1/debris/ene_acc_bulldozer_throat/">
		</group>

		<group name="units/pd2_mod_nypd/characters/ene_bulldozer_1/debris/ene_acc_shoulderpad_l/">
		</group>

		<group name="units/pd2_mod_nypd/characters/ene_bulldozer_1/debris/ene_acc_thigh_l/">
		</group>

		<group name="units/pd2_mod_nypd/characters/ene_bulldozer_3/">
		</group>

		<group name="units/pd2_mod_nypd/characters/ene_city_heavy_g36/">
		</group>

		<group name="units/pd2_mod_nypd/characters/ene_city_heavy_r870/">
		</group>

		<group name="units/pd2_mod_nypd/characters/ene_city_swat_1/">
		</group>

		<group name="units/pd2_mod_nypd/characters/ene_city_swat_2/">
		</group>

		<group name="units/pd2_mod_nypd/characters/ene_city_swat_3/">
		</group>

		<group name="units/pd2_mod_nypd/characters/ene_shield_gensec/">
		</group>

		<group name="units/pd2_mod_nypd/characters/ene_sniper_3/">
		</group>

		<group name="units/pd2_mod_nypd/characters/shared_textures/">
		</group>

	</group>

</assets>
