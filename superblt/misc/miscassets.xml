			<file :name="ene_bulldozer_biker_1.model"/>
			<file :name="ene_bulldozer_biker_1.object"/>
			<xml :name="ene_bulldozer_biker_1.sequence_manager" from_type="custom_xml" to_type="binary"/>
			<file :name="ene_bulldozer_biker_1.unit"/>
			<file :name="ene_bulldozer_biker_1_contour.material_config"/>
			<file :name="ene_bulldozer_biker_1_df.texture"/>
			<file :name="ene_bulldozer_biker_1_husk.unit"/>
