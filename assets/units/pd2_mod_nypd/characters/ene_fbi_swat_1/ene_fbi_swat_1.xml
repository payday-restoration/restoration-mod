<sequence_manager>
	<unit>
		<variables>
			
			<!-- heavy swat -->
			<var_gadgets_blue_heavy value="0"/>					
			
			<!-- blue swat -->
			<var_gadgets_blue_light value="0"/>					
			
			<!-- goggle a -->
			<var_goggles value="0"/>					
		</variables>
	
		<body name="'glass_swat'">
			<endurance bullet="1" explosion="4">
				<run_sequence name="'crk_goggles'"/>
			</endurance>
		</body>	

		<body name="'glass_c'">
			<endurance bullet="1" explosion="4">
				<run_sequence name="'crk_goggles'"/>
			</endurance>
		</body>	
		
		<body name="'altyn_visor'">
			<endurance explosion="6">
				<run_sequence name="'destroy_visor'"/>
			</endurance>
		</body>	

		<body name="'glass_shield'">
			<endurance bullet="2" explosion="4">
				<run_sequence name="'crk_visor'"/>
			</endurance>
			<endurance explosion="6">
				<run_sequence name="'destroy_visor'"/>
			</endurance>
		</body>	

		<filter name="'check_blue_heavy_ar'">
			<check value="vars.var_gadgets_blue_heavy == 1"/>
		</filter>
		<filter name="'check_blue_heavy_sg'">
			<check value="vars.var_gadgets_blue_heavy == 2"/>
		</filter>

		<filter name="'check_blue_smg'">
			<check value="vars.var_gadgets_blue_light == 1"/>
		</filter>
		
		<filter name="'check_blue_sg'">
			<check value="vars.var_gadgets_blue_light == 2"/>
		</filter>

		<filter name="'check_goggle_a'">
			<check value="vars.var_goggles == 1"/>
		</filter>

		<filter name="'check_goggle_b'">
			<check value="vars.var_goggles == 2"/>
		</filter>
		
		<filter name="'check_goggle_c'">
			<check value="vars.var_goggles == 3"/>
		</filter>
		
		<filter name="'check_goggle_d'">
			<check value="vars.var_goggles == 4"/>
		</filter>
		
		<filter name="'check_blue_ar'">
			<check value="vars.var_gadgets_blue_light == 3"/>
		</filter>
		
		<filter name="'check_blue_sniper'">
			<check value="vars.var_gadgets_blue_light == 4"/>
		</filter>
		
		<filter name="'check_blue_heavy_shield'">
			<check value="vars.var_gadgets_blue_light == 5"/>
		</filter>
		
		<sequence editable_state="true" name="'swat_smg'" triggable="true" once="true">						
			<set_variables var_gadgets_blue_light="1"/>
			<run_sequence name="'gadget_meat_grinder'"/>		
		</sequence>

		<sequence editable_state="true" name="'swat_sg'" triggable="true" once="true">						
			<set_variables var_gadgets_blue_light="2"/>
			<run_sequence name="'gadget_meat_grinder'"/>		
		</sequence>

		<sequence editable_state="true" name="'swat_ar'" triggable="true" once="true">						
			<set_variables var_gadgets_blue_light="3"/>
			<run_sequence name="'gadget_meat_grinder'"/>		
		</sequence>		

		<sequence editable_state="true" name="'swat_sniper'" triggable="true" once="true">						
			<set_variables var_gadgets_blue_light="4"/>
			<run_sequence name="'gadget_meat_grinder'"/>		
		</sequence>

		<sequence editable_state="true" name="'swat_shield'" triggable="true" once="true">						
			<set_variables var_gadgets_blue_light="5"/>
			<run_sequence name="'gadget_meat_grinder'"/>		
		</sequence>

		<sequence editable_state="true" name="'heavy_swat_sg'" triggable="true" once="true">						
			<set_variables var_gadgets_blue_heavy="2"/>
			<run_sequence name="'gadget_meat_grinder'"/>		
		</sequence>

		<sequence editable_state="true" name="'heavy_swat_ar'" triggable="true" once="true">						
			<set_variables var_gadgets_blue_heavy="1"/>
			<run_sequence name="'gadget_meat_grinder'"/>		
		</sequence>
		
		<sequence editable_state="true" name="'gadget_meat_grinder'" triggable="true" once="true">	
			<!-- GENERIC -->
			<run_sequence filter="'check_blue_smg'" name="'holster_'..pick('r','r','r','r','l','l','twinnem')"/>
			<run_sequence filter="'check_blue_sg'" name="'holster_'..pick('r','r','r','r','l','l','twinnem')"/>
			<run_sequence filter="'check_blue_ar'" name="'holster_'..pick('r','r','r','r','l','l','twinnem')"/>
			<run_sequence filter="'check_blue_heavy_ar'" name="'holster_'..pick('r','r','r','r','l','l','twinnem')"/>
			<run_sequence filter="'check_blue_heavy_sg'" name="'holster_'..pick('r','r','r','r','l','l','twinnem')"/>
			
			
			<!-- smg -->
			<object filter="'check_blue_smg'" enabled="true" name="'g_swat_smg'"/>						
			<object filter="'check_blue_smg'" enabled="false" name="'g_helmet_lod1'"/>						
			<object filter="'check_blue_smg'" enabled="false" name="'g_helmet_lod2'"/>						
			<object filter="'check_blue_smg'" enabled="true" name="'g_swat_smg_lod1'"/>						
			<run_sequence filter="'check_blue_smg'" name="'totally_'..pick('nothing', 'nothing', 'random', 'nothing')"/>
			<run_sequence filter="'check_blue_smg'" name="'goggles_'..pick('c','c','c','c', 'c', 'd', 'c')"/>														
	
			<!-- sg -->
			<object filter="'check_blue_sg'" enabled="true" name="'g_swat_sg'"/>
			<object filter="'check_blue_sg'" enabled="true" name="'g_swat_sg_lod1'"/>								
			<object filter="'check_blue_sg'" enabled="true" name="'g_body_shitbag'"/>						
			<object filter="'check_blue_sg'" enabled="true" name="'g_body_shitbag_lod1'"/>
			<object filter="'check_blue_sg'" enabled="false" name="'g_body'"/>						
			<run_sequence filter="'check_blue_sg'" name="'helmet'..pick('_headset','_headset','_headset','_headset','_headset','nun_actually','_headset')"/>
			<run_sequence filter="'check_blue_sg'" name="'helmet'..pick('_pillow','_pillow','_pillow','_pillow','nun_actually','_pillow','_pillow')"/>
			<object filter="'check_blue_sg'" enabled="false" name="'g_body_lod1'"/>

			<!-- rifleman -->			
			<object filter="'check_blue_ar'" enabled="true" name="'g_swat_ar'"/>						
			<object filter="'check_blue_ar'" enabled="true" name="'g_swat_ar_lod1'"/>
			<run_sequence filter="'check_blue_ar'" name="'goggles_'..pick('a','a','b','b', 'a', 'a', 'd')"/>														
			<run_sequence filter="'check_blue_ar'" name="'helmet'..pick('_flashlight','_flashlight','_flashlight','_flashlight','_flashlight','nun_actually','_flashlight')"/>
			<run_sequence filter="'check_blue_ar'" name="'helmet'..pick('_headset','_headset','_headset','_headset','_headset','nun_actually','_headset')"/>

			<!-- heavy rifleman -->			
			<object filter="'check_blue_heavy_ar'" enabled="true" name="'g_swat_heavy_ar'"/>						
			<object filter="'check_blue_heavy_ar'" enabled="true" name="'g_swat_heavy_ar_lod1'"/>
			<run_sequence filter="'check_blue_heavy_ar'" name="'heavy_helmet_b'"/>
			<object filter="'check_blue_heavy_ar'" enabled="false" name="'g_body'"/>						
			<object filter="'check_blue_heavy_ar'" enabled="false" name="'g_body_lod1'"/>
			<object filter="'check_blue_heavy_ar'" enabled="true" name="'g_body_heavy'"/>						
			<object filter="'check_blue_heavy_ar'" enabled="true" name="'g_body_heavy_lod1'"/>
			<body	filter="'check_blue_heavy_ar'" enabled="true" name="'body_plate'" />										
			<decal_mesh	filter="'check_blue_heavy_ar'" enabled="true" name="'c_body_plate'" />	

			<!-- heavy sg -->	
			<object filter="'check_blue_heavy_sg'" enabled="true" name="'g_swat_heavy_sg'"/>						
			<object filter="'check_blue_heavy_sg'" enabled="true" name="'g_swat_heavy_sg_lod1'"/>
			<run_sequence filter="'check_blue_heavy_sg'" name="'heavy_helmet_c'"/>
			<object filter="'check_blue_heavy_sg'" enabled="false" name="'g_body'"/>						
			<object filter="'check_blue_heavy_sg'" enabled="false" name="'g_body_lod1'"/>
			<object filter="'check_blue_heavy_sg'" enabled="true" name="'g_body_heavy'"/>						
			<object filter="'check_blue_heavy_sg'" enabled="true" name="'g_body_heavy_lod1'"/>
			<body	filter="'check_blue_heavy_sg'" enabled="true" name="'body_plate'" />										
			<decal_mesh	filter="'check_blue_heavy_sg'" enabled="true" name="'c_body_plate'" />	

			<!-- shield -->			
			<object filter="'check_blue_heavy_shield'" enabled="true" name="'g_body_shield'"/>						
			<object filter="'check_blue_heavy_shield'" enabled="true" name="'g_body_shield_lod1'"/>
			<object filter="'check_blue_heavy_shield'" enabled="false" name="'g_body'"/>						
			<object filter="'check_blue_heavy_shield'" enabled="false" name="'g_body_lod1'"/>			
			<run_sequence filter="'check_blue_heavy_shield'" name="'heavy_helmet_b'"/>
			<run_sequence filter="'check_blue_heavy_shield'" name="'helmet'..pick('nun_actually','nun_actually','nun_actually','nun_actually','_headset','nun_actually','nun_actually')"/>
									
			<!-- sniper -->			
			<object filter="'check_blue_sniper'" enabled="true" name="'g_sniper'"/>						
			<object filter="'check_blue_sniper'" enabled="true" name="'g_sniper_lod1'"/>
			<object filter="'check_blue_sniper'" enabled="false" name="'g_helmet_lod1'"/>
			<run_sequence filter="'check_blue_sniper'" name="'goggles_'..pick('a','a', 'a', 'a', 'd')"/>
			<object filter="'check_blue_sniper'" enabled="false" name="'g_helmet_lod2'"/>
			<object filter="'check_blue_sniper'" enabled="false" name="'g_body'"/>						
			<object filter="'check_blue_sniper'" enabled="false" name="'g_body_lod1'"/>
			<decal_mesh filter="'check_blue_sniper'" enabled="false" name="'dm_helmet'"/>					
			<run_sequence filter="'check_blue_sniper'" name="'helmet'..pick('_headset','_headset','_headset','_headset','_headset','nun_actually','_headset')"/>
			<run_sequence filter="'check_blue_sniper'" name="'hat'..pick('_b','_b','_b','_b','_b','_a','_b')"/>
			
		</sequence>

		<sequence editable_state="true" name="'spawn_helmet'" once="true" triggable="true">
			<decal_mesh filter="'check_goggle_b'" enabled="false" name="'c_glass'" />										
			<object filter="'check_goggle_b'" enabled="false" name="'g_glass'" />										
			<object filter="'check_goggle_b'" enabled="false" name="'g_glass_crk'" />										
			<body filter="'check_goggle_b'" enabled="false" name="'glass_swat'" />	
									
			<decal_mesh enabled="false" name="'c_glass_shield'" />																		
			<body enabled="false" name="'glass_shield'" />	
			
			<decal_mesh enabled="false" name="'c_visor'" />																		
			<body enabled="false" name="'altyn_visor'" />	
			
			<run_sequence name="'destroy_visor'"/>						
		</sequence>

		<sequence editable_state="true" name="'helmet_headset'" once="true" triggable="true">		
			<object enabled="true" name="'g_headset'"/>
			<object enabled="true" name="'g_headset_lod1'"/>
		</sequence>

		<sequence editable_state="true" name="'hat_a'" once="true" triggable="true">		
			<object enabled="true" name="'g_hat_lod1'"/>
			<object enabled="true" name="'g_hat_lod2'"/>
		</sequence>

		<sequence editable_state="true" name="'hat_b'" once="true" triggable="true">		
			<object enabled="true" name="'g_hat_lod3'"/>
			<object enabled="true" name="'g_hat_lod4'"/>
		</sequence>
		
		<!-- HEAVY HELMET 'B' SHIELD -->
		<sequence editable_state="true" name="'heavy_helmet_b'" once="true" triggable="true">
			<object enabled="true" name="'g_helmet_lod4'"/>
			<object enabled="true" name="'g_helmet_lod6'"/>
			<decal_mesh enabled="true" name="'c_glass_shield'" />										
			<body enabled="true" name="'glass_shield'" />										
		</sequence>
		
		<!-- HEAVY HELMET 'C' SG -->		
		<sequence editable_state="true" name="'heavy_helmet_c'" once="true" triggable="true">
			<object enabled="true" name="'g_helmet_lod7'"/>
			<object enabled="true" name="'g_helmet_lod8'"/>
			<decal_mesh enabled="true" name="'c_visor'" />										
			<body enabled="true" name="'altyn_visor'" />										
		</sequence>

		<!-- Missing helmet sequences -->
		<sequence editable_state="true" name="'helmet_nun_actually'" once="true" triggable="true">
			<!-- Empty - nun actually helmet variant -->
		</sequence>

		<!-- Missing totally sequence -->
		<sequence editable_state="true" name="'totally_nothing'" once="true" triggable="true">
			<!-- Empty - totally nothing variant -->
		</sequence>
		
		<sequence editable_state="true" name="'totally_random'" once="true" triggable="true">
			<object enabled="true" name="'g_body_shitbag'"/>
			<object enabled="true" name="'g_body_shitbag_lod1'"/>
			<object enabled="false" name="'g_body'"/>
			<object enabled="false" name="'g_body_lod1'"/>
		</sequence>
		
		<sequence editable_state="true" name="'heavy_helmet_d'" once="true" triggable="true">
			<object enabled="false" name="'g_helmet_lod1'"/>
			<object enabled="false" name="'g_helmet_lod2'"/>
			<object enabled="false" name="'g_helmet_lod3'"/>
			<object enabled="true" name="'g_helmet_grenadier_lod1'" />										
			<object enabled="true" name="'g_helmet_grenadier_lod2'" />				
			<object enabled="true" name="'g_glass_l'" />										
			<object enabled="true" name="'g_glass_r'" />							
			<decal_mesh enabled="true" name="'c_mask'" />										
			<decal_mesh enabled="true" name="'c_glass_l'" />										
			<decal_mesh enabled="true" name="'c_glass_r'" />										
			<decal_mesh enabled="false" name="'c_glass_shield'" />										
			<body enabled="false" name="'glass_swat'" />										
			<body enabled="true" name="'sg_mask'" />										
			<body enabled="true" name="'glass_l'" />										
			<body enabled="true" name="'glass_r'" />	
		</sequence>

		<sequence editable_state="true" name="'crk_visor'" once="true" triggable="true">			
			<object enabled="false" name="'g_helmet_lod4'"/>
			<object enabled="true" name="'g_helmet_lod5'"/>
			<effect damp_time="5" name="'effects/particles/bullet_hit/glass_breakable/bullet_hit_glass_breakable'" parent="object( 'Head' )" position="v()"/>			
		</sequence>				

		<sequence editable_state="true" name="'destroy_visor'" once="true" triggable="true">			
			<body  	enabled="false" name="'glass_shield'"/>
			<body  	enabled="false" name="'altyn_visor'"/>
			<object enabled="false" name="'g_helmet_lod7'"/>			
			<object enabled="false" name="'g_helmet_lod4'"/>
			<object enabled="false" name="'g_helmet_lod5'"/>
			<decal_mesh enabled="false" name="'c_glass_shield'" />					
			<decal_mesh enabled="false" name="'c_visor'" />				
			
			<effect filter="'check_blue_heavy_ar'" damp_time="5" name="'effects/particles/bullet_hit/glass_breakable/bullet_hit_glass_breakable'" parent="object( 'Head' )" position="v()"/>
			<effect filter="'check_blue_heavy_shield'" damp_time="5" name="'effects/particles/bullet_hit/glass_breakable/bullet_hit_glass_breakable'" parent="object( 'Head' )" position="v()"/>
			<effect filter="'check_blue_heavy_sg'" damp_time="5" name="'effects/payday2/particles/impacts/metal_impact_pd2'" parent="object( 'Head' )" position="v()"/>
			<effect filter="'check_blue_heavy_sg'" damp_time="5" name="'effects/payday2/particles/impacts/metal_impact_pd2'" parent="object( 'Head' )" position="v()"/>
			<sound 	filter="'check_blue_heavy_ar'" action="'play'" event="'swat_heavy_visor_shatter'" object="'Head'"/>			
			<sound  filter="'check_blue_heavy_ar'" action="'play'" event="'swat_heavy_visor_shatter'" object="'Head'"/>			
			<sound 	filter="'check_blue_heavy_sg'" action="'play'" event="'swatturret_weakspot_hit'" object="'Head'"/>			
			<sound  filter="'check_blue_heavy_sg'" action="'play'" event="'swatturret_weakspot_hit'" object="'Head'"/>			
			<sound 	filter="'check_blue_heavy_shield'" action="'play'" event="'swat_heavy_visor_shatter'" object="'Head'"/>			
			<sound  filter="'check_blue_heavy_shield'" action="'play'" event="'swat_heavy_visor_shatter'" object="'Head'"/>			
		</sequence>				
		
		<sequence editable_state="true" name="'goggles_a'" once="true" triggable="true">
			<object enabled="true" name="'g_goggles_a'"/>
			<object enabled="true" name="'g_goggles_a_lod1'"/>
			<object enabled="true" name="'g_glass'"/>
			<set_variables var_goggles="1"/>					
			<decal_mesh enabled="true" name="'c_glass'" />					
			<body enabled="true" name="'glass_swat'" />					
		</sequence>

		<sequence editable_state="true" name="'crk_goggles'" once="true" triggable="true">
			<object filter="'check_goggle_a'" enabled="true" name="'g_glass_crk'"/>
			<object filter="'check_goggle_a'" enabled="false" name="'g_glass'"/>
						
			<object filter="'check_goggle_c'" enabled="false" name="'g_glass_c'"/>
			<object filter="'check_goggle_c'" enabled="true" name="'g_glass_c_crk'"/>		
		</sequence>				
		
		<sequence editable_state="true" name="'goggles_b'" once="true" triggable="true">
			<object enabled="true" name="'g_helmet_lod3'"/>
			<object enabled="true" name="'g_goggles_a_lod1'"/>
			<object enabled="true" name="'g_glass'"/>
			<set_variables var_goggles="2"/>										
			<decal_mesh enabled="true" name="'dm_glass'" />					
			<body enabled="true" name="'glass_swat'" />										
		</sequence>
		
		<sequence editable_state="true" name="'goggles_c'" once="true" triggable="true">
			<object enabled="true" name="'g_goggles_c'"/>
			<object enabled="true" name="'g_goggles_c_lod1'"/>
			<object enabled="true" name="'g_glass_c'"/>
			<set_variables var_goggles="3"/>										
			<decal_mesh enabled="true" name="'c_glass_c'" />					
			<body enabled="true" name="'glass_c'" />										
		</sequence>
		
		<sequence editable_state="true" name="'goggles_d'" once="true" triggable="true">
			<object enabled="true" name="'g_glasses'"/>
			<object enabled="true" name="'g_glasses_glass'"/>
			<set_variables var_goggles="4"/>										
		</sequence>

		<sequence editable_state="true" name="'helmet_flashlight'" once="true" triggable="true">
			<object enabled="true" name="'g_helmet_lod9'"/>
			<object enabled="true" name="'g_helmet_lod10'"/>
		</sequence>

		<sequence editable_state="true" name="'helmet_pillow'" once="true" triggable="true">
			<object enabled="true" name="'g_helmet_lod11'"/>
			<object enabled="true" name="'g_helmet_lod12'"/>
		</sequence>
		<!-- RANDOM HELMETS end -->
						
		<!-- RANDOM HOLSTERS -->
		<sequence editable_state="true" name="'holster_l'" once="true" triggable="true">
			<object enabled="true" name="'g_holster_l'"/>
			<object enabled="true" name="'g_holster_l_lod1'"/>
			<object enabled="false" name="'g_holster_r'"/>
			<object enabled="false" name="'g_holster_r_lod1'"/>
		</sequence>

		<sequence editable_state="true" name="'holster_r'" once="true" triggable="true">
			<object enabled="true" name="'g_holster_l'"/>
			<object enabled="true" name="'g_holster_l_lod1'"/>
		</sequence>																

		<sequence editable_state="true" name="'holster_twinnem'" once="true" triggable="true">
			<object enabled="true" name="'g_holster_l'"/>
			<object enabled="true" name="'g_holster_l_lod1'"/>
			<object enabled="true" name="'g_holster_r'"/>
			<object enabled="true" name="'g_holster_r_lod1'"/>
		</sequence>								
		<!-- RANDOM HOLSTERS end -->

	
		<sequence editable_state="true" name="'disable_hitbox'" triggable="true">
			<body enabled="false" name="'body'"/>
			<body enabled="false" name="'Head'"/>
			<body enabled="false" name="'rag_LeftLeg'"/>
			<body enabled="false" name="'rag_RightLeg'"/>
			<body enabled="false" name="'rag_RightUpLeg'"/>
			<body enabled="false" name="'rag_LeftUpLeg'"/>
		</sequence>
		<sequence editable_state="true" name="'leg_arm_hitbox'" triggable="true">
			<body enabled="true" name="'body'"/>
			<body enabled="true" name="'Head'"/>
			<body enabled="false" motion="'keyframed'" name="'rag_Hips'"/>
			<body enabled="true" motion="'keyframed'" name="'rag_LeftUpLeg'"/>
			<body enabled="true" motion="'keyframed'" name="'rag_RightUpLeg'"/>
			<body enabled="true" motion="'keyframed'" name="'rag_LeftLeg'"/>
			<body enabled="true" motion="'keyframed'" name="'rag_RightLeg'"/>
			<body enabled="false" motion="'keyframed'" name="'rag_Spine'"/>
			<body enabled="false" motion="'keyframed'" name="'rag_Spine1'"/>
			<body enabled="false" motion="'keyframed'" name="'rag_Spine2'"/>
			<body enabled="false" motion="'keyframed'" name="'rag_LeftForeArm'"/>
			<body enabled="false" motion="'keyframed'" name="'rag_RightForeArm'"/>
			<body enabled="false" motion="'keyframed'" name="'rag_LeftArm'"/>
			<body enabled="false" motion="'keyframed'" name="'rag_RightArm'"/>
			<body enabled="false" motion="'keyframed'" name="'rag_Head'"/>
			<constraint enabled="false" name="'LeftUpLeg'"/>
			<constraint enabled="false" name="'RightUpLeg'"/>
			<constraint enabled="false" name="'LeftLeg'"/>
			<constraint enabled="false" name="'RightLeg'"/>
			<constraint enabled="false" name="'Spine'"/>
			<constraint enabled="false" name="'Spine1'"/>
			<constraint enabled="false" name="'Spine2'"/>
			<constraint enabled="false" name="'LeftForeArm'"/>
			<constraint enabled="false" name="'RightForeArm'"/>
			<constraint enabled="false" name="'LeftArm'"/>
			<constraint enabled="false" name="'RightArm'"/>
			<constraint enabled="false" name="'Head'"/>
		</sequence>
		<sequence editable_state="true" name="'prepare_ragdoll'" triggable="true">
			<body enabled="false" motion="'dynamic'" name="'rag_Hips'"/>
			<body enabled="false" motion="'dynamic'" name="'rag_LeftUpLeg'"/>
			<body enabled="false" motion="'dynamic'" name="'rag_RightUpLeg'"/>
			<body enabled="false" motion="'dynamic'" name="'rag_LeftLeg'"/>
			<body enabled="false" motion="'dynamic'" name="'rag_RightLeg'"/>
			<body enabled="false" motion="'dynamic'" name="'rag_Spine'"/>
			<body enabled="false" motion="'dynamic'" name="'rag_Spine1'"/>
			<body enabled="false" motion="'dynamic'" name="'rag_Spine2'"/>
			<body enabled="false" motion="'dynamic'" name="'rag_LeftForeArm'"/>
			<body enabled="false" motion="'dynamic'" name="'rag_RightForeArm'"/>
			<body enabled="false" motion="'dynamic'" name="'rag_LeftArm'"/>
			<body enabled="false" motion="'dynamic'" name="'rag_RightArm'"/>
			<body enabled="false" motion="'dynamic'" name="'bag'"/>
			<body enabled="false" motion="'dynamic'" name="'bag_gren'"/>
		</sequence>
		<sequence editable_state="true" name="'switch_to_ragdoll'" triggable="true">
			<body enabled="false" name="'body'"/>
