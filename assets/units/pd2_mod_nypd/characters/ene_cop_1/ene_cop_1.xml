		</sequence>

		<filter name="'check_cop_pistol'">
			<check value="vars.var_gadgets_cop == 1"/>
		</filter>

		<filter name="'check_cop_rev'">
			<check value="vars.var_gadgets_cop == 2"/>
		</filter>

		<filter name="'check_cop_smg'">
			<check value="vars.var_gadgets_cop == 3"/>
		</filter>

		<filter name="'check_cop_sg'">
			<check value="vars.var_gadgets_cop == 4"/>
		</filter>
		
		<filter name="'check_cop'">
			<check value="vars.var_gadgets_cop < 4"/>
		</filter>
		<filter name="'check_sec'">
			<check value="vars.var_gadgets_sec < 3"/>
		</filter>
		<filter name="'check_redsec'">
			<check value="vars.var_gadgets_sec > 3"/>
		</filter>

		<filter name="'check_sec_pistol'">
			<check value="vars.var_gadgets_sec == 1"/>
		</filter>

		<filter name="'check_sec_smg'">
			<check value="vars.var_gadgets_sec == 2"/>
		</filter>

		<filter name="'check_sec_sg'">
			<check value="vars.var_gadgets_sec == 3"/>
		</filter>

		<filter name="'check_redsec_pistol'">
			<check value="vars.var_gadgets_sec == 4"/>
		</filter>
		
		<filter name="'check_redsec_smg'">
			<check value="vars.var_gadgets_sec == 5"/>
		</filter>
		
		<filter name="'check_redsec_sg'">
			<check value="vars.var_gadgets_sec == 6"/>
		</filter>
				
		<filter name="'check_fbi_1'">
			<check value="vars.var_gadgets_fbi == 1"/>
		</filter>
		
		<filter name="'check_fbi_2'">
			<check value="vars.var_gadgets_fbi == 2"/>
		</filter>
		
		
		<filter name="'check_fbi_3'">
			<check value="vars.var_gadgets_fbi == 3"/>
		</filter>		
		
		<filter name="'check_fbi_vet'">
			<check value="vars.var_gadgets_fbi == 4"/>
		</filter>		
		
		<filter name="'check_fbi_vet_blood'">
			<check value="vars.var_gadgets_fbi == 5"/>
		</filter>		

		<sequence editable_state="true" name="'gadget_meat_grinder'" triggable="true" once="true">	
			<!-- GENERIC -->

			<run_sequence filter="check_cop" name="'acc_'..pick('nothing','tie','nothing', 'nothing')"/>
			<run_sequence filter="check_cop" name="'acc_'..pick('nothing','shades','nothing', 'nothing')"/>			
			<run_sequence name="'acc_'..pick('nothing','watch','nothing', 'nothing')"/>
			<run_sequence name="'acc_'..pick('nothing','watch','nothing', 'nothing')"/>
			
			<!-- pistol -->
			<run_sequence filter="'check_cop_pistol'" name="'body_cop_pis'"/>
			<run_sequence filter="'check_cop_pistol'" name="'body_cop'..pick('_shortsleeve','_shortsleeve','_shortsleeve', '_shortsleeve', '_shortsleeve', '_longsleeve', '_shortsleeve', '_shortsleeve')"/>
			
			<!-- revolver -->
			<run_sequence filter="'check_cop_rev'" name="'body_cop_rev'"/>
	
			<!-- smg -->
			<run_sequence filter="'check_cop_smg'" name="'body_cop_smg'"/>
			<run_sequence filter="'check_cop_smg'" name="'body_cop'..pick('_shortsleeve','_shortsleeve','_shortsleeve', '_shortsleeve', '_shortsleeve', '_longsleeve', '_shortsleeve', '_shortsleeve')"/>
			
			<!-- sg -->
			<run_sequence filter="'check_cop_sg'" name="'body_cop_sg'"/>
				
			<!-- sec pistol -->
			<run_sequence filter="'check_sec_pistol'" name="'body_sec_pis'"/>
			<run_sequence filter="'check_sec_pistol'" name="'body_sec'..pick('_shortsleeve','_shortsleeve','_shortsleeve', '_shortsleeve', '_shortsleeve', '_longsleeve', '_shortsleeve', '_shortsleeve')"/>
			
			<!-- sec smg -->
			<run_sequence filter="'check_sec_smg'" name="'body_sec_smg'"/>
			<run_sequence filter="'check_sec_smg'" name="'body_sec'..pick('_longsleeve','_longsleeve','_longsleeve', '_longsleeve', '_longsleeve', '_longsleeve', '_shortsleeve', '_longsleeve')"/>
			<run_sequence filter="check_sec" name="'acc_'..pick('nothing','tie_red','nothing', 'nothing')"/>
			
			<!-- sec sg -->
			<run_sequence filter="'check_sec_sg'" name="'body_sec_sg'"/>
			<run_sequence filter="'check_sec_sg'" name="'body_sec'..pick('_shortsleeve','_shortsleeve','_shortsleeve', '_shortsleeve', '_shortsleeve', '_longsleeve', '_shortsleeve', '_shortsleeve')"/>
			
			<!-- red pistol -->
			<run_sequence filter="check_redsec" name="'acc_'..pick('nothing','tie','nothing', 'nothing')"/>
		
			<run_sequence filter="'check_redsec_pistol'" name="'body_red_sec_pis'"/>
			<run_sequence filter="'check_redsec_pistol'" name="'body_secred'..pick('_shortsleeve','_shortsleeve','_shortsleeve', '_shortsleeve', '_shortsleeve', '_longsleeve', '_shortsleeve', '_shortsleeve')"/>
			
			<!-- red smg -->
			<run_sequence filter="'check_redsec_smg'" name="'body_red_sec_smg'"/>
			<run_sequence filter="'check_redsec_smg'" name="'body_secred'..pick('_longsleeve','_longsleeve','_longsleeve', '_longsleeve', '_longsleeve', '_longsleeve', '_shortsleeve', '_longsleeve')"/>
			
			<!-- red sg -->
			<run_sequence filter="'check_redsec_sg'" name="'body_red_sec_sg'"/>
			<run_sequence filter="'check_redsec_sg'" name="'body_secred'..pick('_longsleeve','_longsleeve','_longsleeve', '_longsleeve', '_longsleeve', '_longsleeve', '_shortsleeve', '_longsleeve')"/>
			
			<!-- fbi 1 -->
			<run_sequence filter="check_fbi_1" name="'acc_'..pick('nothing','tie_blue','nothing', 'nothing')"/>
			<run_sequence filter="check_fbi_1" name="'acc_'..pick('nothing','earpiece','nothing', 'nothing')"/>		
			<run_sequence filter="check_fbi_1" name="'acc_'..pick('shades','shades','nothing', 'nothing')"/>						
			<run_sequence filter="'check_fbi_1'" name="'body_fbi'..pick('_longsleeve','_longsleeve','_longsleeve', '_longsleeve', '_longsleeve', '_longsleeve', '_shortsleeve', '_longsleeve')"/>
			<object filter="'check_fbi_1'" enabled="true" name="'g_body_fbi1'"/>
			<object filter="'check_fbi_1'" enabled="true" name="'g_body_fbi1_lod1'"/>				
									
			<!-- fbi 2 -->
			<run_sequence filter="check_fbi_2" name="'acc_'..pick('nothing','tie_blue','nothing', 'nothing')"/>
			
			<run_sequence filter="'check_fbi_2'" name="'fbi_2_var'"/>
			<run_sequence filter="'check_fbi_2'" name="'body_fbi'..pick('_longsleeve','_longsleeve','_longsleeve', '_longsleeve', '_longsleeve', '_longsleeve', '_shortsleeve', '_longsleeve')"/>
			
			<!-- fbi 3 -->
			<run_sequence filter="'check_fbi_3'" name="'fbi_3_var'"/>
