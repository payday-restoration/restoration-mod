<?xml version="1.0"?>
<assets base_path="assets/">

	<!-- ///GENSEC MISC\\\ -->
	<!-- Registration only, at mod init: this creates the DB entries that make the mod's
	     files win over the base game's. It must happen at boot - a scripted group only
	     registers when it is loaded, which is during GameSetup:load_packages, by which
	     point the level's own packages have already resolved the base-game files and the
	     overrides do nothing.

	     Nothing is dyn-loaded from here (dyn_package="false"). Which units get handed to
	     dyn_resource, and for which faction, is driven from lua/sc/superblt_units.lua,
	     which loads each dbpath exactly once - handing the same one over twice leaves a
	     load that never completes and hangs the level on a black screen. -->
	<group dyn_package="false">

		<group name="units/payday2/characters/ene_acc_evilberet/">
			<file :name="ene_acc_evilberet.cooked_physics"/>
			<file :name="ene_acc_evilberet.material_config"/>
			<file :name="ene_acc_evilberet.model"/>
			<file :name="ene_acc_evilberet.object"/>
			<file :name="ene_acc_evilberet.unit"/>
		</group>

		<group name="units/payday2/characters/ene_bulldozer_1_sc/">
			<file :name="ene_bulldozer_1_sc.material_config"/>
			<file :name="ene_bulldozer_1_sc.model"/>
			<file :name="ene_bulldozer_1_sc.object"/>
			<xml :name="ene_bulldozer_1_sc.sequence_manager" from_type="custom_xml" to_type="binary"/>
			<file :name="ene_bulldozer_1_sc.unit"/>
			<file :name="ene_bulldozer_1_sc_contour.material_config"/>
			<file :name="ene_bulldozer_1_sc_husk.unit"/>
		</group>

		<group name="units/payday2/characters/ene_bulldozer_1_sc/debris/ene_acc_bulldozer_helmet/">
			<file :name="ene_acc_bulldozer_helmet.model"/>
			<file :name="ene_acc_bulldozer_helmet.object"/>
			<file :name="ene_acc_bulldozer_helmet.unit"/>
		</group>

		<group name="units/payday2/characters/ene_bulldozer_3_sc/">
			<file :name="ene_bulldozer_3_sc.material_config"/>
			<file :name="ene_bulldozer_3_sc.unit"/>
			<file :name="ene_bulldozer_3_sc_contour.material_config"/>
			<file :name="ene_bulldozer_3_sc_husk.unit"/>
		</group>

		<group name="units/payday2/characters/ene_bulldozer_3_sc/debris/ene_acc_bulldozer_helmet/">
			<file :name="ene_acc_bulldozer_helmet.model"/>
			<file :name="ene_acc_bulldozer_helmet.object"/>
			<file :name="ene_acc_bulldozer_helmet.unit"/>
		</group>

		<group name="units/payday2/characters/ene_city_guard_1/">
			<file :name="ene_city_guard_1.material_config"/>
			<file :name="ene_city_guard_1.unit"/>
			<file :name="ene_city_guard_1_contour.material_config"/>
			<file :name="ene_city_guard_1_husk.unit"/>
		</group>

		<group name="units/payday2/characters/ene_city_guard_2/">
			<file :name="ene_city_guard_2.unit"/>
			<file :name="ene_city_guard_2_husk.unit"/>
		</group>

		<group name="units/payday2/characters/ene_city_guard_3/">
			<file :name="ene_city_guard_3.unit"/>
			<file :name="ene_city_guard_3_husk.unit"/>
		</group>

		<group name="units/payday2/characters/ene_city_swat_1_sc/">
			<file :name="ene_city_swat_1_sc.model"/>
			<file :name="ene_city_swat_1_sc.object"/>
			<xml :name="ene_city_swat_1_sc.sequence_manager" from_type="custom_xml" to_type="binary"/>
			<file :name="ene_city_swat_1_sc.unit"/>
			<file :name="ene_city_swat_1_sc_husk.unit"/>
		</group>

		<group name="units/payday2/characters/ene_city_swat_2_sc/">
			<file :name="ene_city_swat_2_sc.unit"/>
			<file :name="ene_city_swat_2_sc_husk.unit"/>
		</group>

		<group name="units/payday2/characters/ene_city_swat_3_sc/">
			<file :name="ene_city_swat_3_sc.unit"/>
			<file :name="ene_city_swat_3_sc_husk.unit"/>
		</group>

		<group name="units/payday2/characters/shared_textures/">
			<file :name="bulldozer_city_df.texture"/>
			<file :name="helmets_city_df.texture"/>
			<file :name="swat_city_df.texture"/>
			<file :name="swat_city_df_guard.texture"/>
		</group>

	</group>

</assets>
