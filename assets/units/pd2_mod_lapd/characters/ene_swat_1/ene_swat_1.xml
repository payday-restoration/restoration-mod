<sequence_manager>
	<unit>
		<variables>
			
			<!-- heavy swat -->
			<var_gadgets_blue_heavy value="0"/>			
			
			<!-- fbi swat -->
			<var_gadgets_fbi_light value="0"/>					
			
			<!-- blue swat -->
			<var_gadgets_blue_light value="0"/>					
			
			<!-- goggle a -->
			<var_goggles value="0"/>					
		</variables>
	
		<body name="'glass_swat'">
			<endurance bullet="1" explosion="4">
				<run_sequence name="'crk_goggles'"/>
			</endurance>
		</body>	

		<body name="'bag'">
			<endurance damage="36" >
				<run_sequence name="'detonate'"/>
			</endurance>
		</body>	
		
		<body name="'bag_gren'">
			<endurance damage="36" >
				<run_sequence name="'detonate_fart'"/>
			</endurance>
		</body>	
	
		<body name="'glass_visor'">
			<endurance bullet="1" explosion="4">
				<run_sequence name="'crk_visor'"/>
			</endurance>
			<endurance explosion="6">
				<run_sequence name="'destroy_visor'"/>
			</endurance>
		</body>	

		<body name="'glass_shield'">
			<endurance bullet="1" explosion="4">
				<run_sequence name="'crk_visor'"/>
			</endurance>
			<endurance explosion="6">
				<run_sequence name="'destroy_visor'"/>
			</endurance>
		</body>	

		<filter name="'check_blue_heavy_ar'">
			<check value="vars.var_gadgets_blue_heavy == 1"/>
		</filter>
		<filter name="'check_blue_heavy_sg'">
			<check value="vars.var_gadgets_blue_heavy == 2"/>
		</filter>
		<filter name="'check_blue_heavy_shield'">
			<check value="vars.var_gadgets_blue_heavy == 3"/>
		</filter>
		<filter name="'check_blue_taser'">
			<check value="vars.var_gadgets_blue_heavy == 4"/>
		</filter>
		<filter name="'check_blue_gren'">
			<check value="vars.var_gadgets_blue_heavy == 5"/>
		</filter>
		<filter name="'check_fbi_heavy_ar'">
			<check value="vars.var_gadgets_blue_heavy == 6"/>
		</filter>
		<filter name="'check_fbi_heavy_sg'">
			<check value="vars.var_gadgets_blue_heavy == 7"/>
		</filter>

		<filter name="'check_blue_smg'">
			<check value="vars.var_gadgets_blue_light == 1"/>
		</filter>
		
		<filter name="'check_blue_sg'">
			<check value="vars.var_gadgets_blue_light == 2"/>
		</filter>
		
		<filter name="'check_fbi_ar'">
			<check value="vars.var_gadgets_fbi_light == 3"/>
		</filter>
		<filter name="'check_fbi_sg'">
			<check value="vars.var_gadgets_fbi_light == 2"/>
		</filter>
		<filter name="'check_fbi_smg'">
			<check value="vars.var_gadgets_fbi_light == 1"/>
		</filter>

		<filter name="'check_goggle_a'">
			<check value="vars.var_goggles == 1"/>
		</filter>

		<filter name="'check_goggle_b'">
			<check value="vars.var_goggles == 2"/>
		</filter>
		
		<filter name="'check_blue_ar'">
			<check value="vars.var_gadgets_blue_light == 3"/>
		</filter>
		
		<filter name="'check_blue_sniper'">
			<check value="vars.var_gadgets_blue_light == 4"/>
		</filter>
		
		<filter name="'check_fbi_sniper'">
			<check value="vars.var_gadgets_blue_light == 5"/>
		</filter>
		
		<filter name="'check_blue_fbi_shield'">
			<check value="vars.var_gadgets_fbi_light == 4"/>
		</filter>

		<sequence editable_state="true" name="'swat_smg'" triggable="true" once="true">						
			<set_variables var_gadgets_blue_light="1"/>
			<run_sequence name="'gadget_meat_grinder'"/>		
		</sequence>

		<sequence editable_state="true" name="'swat_sg'" triggable="true" once="true">						
			<set_variables var_gadgets_blue_light="2"/>
			<run_sequence name="'gadget_meat_grinder'"/>		
		</sequence>

		<sequence editable_state="true" name="'swat_ar'" triggable="true" once="true">						
			<set_variables var_gadgets_blue_light="3"/>
			<run_sequence name="'gadget_meat_grinder'"/>		
		</sequence>
		
		<sequence editable_state="true" name="'fbi_swat_smg'" triggable="true" once="true">						
			<set_variables var_gadgets_fbi_light="1"/>						
			<run_sequence name="'gadget_meat_grinder'"/>		
		</sequence>

		<sequence editable_state="true" name="'fbi_swat_sg'" triggable="true" once="true">						
			<set_variables var_gadgets_fbi_light="2"/>			
			<run_sequence name="'gadget_meat_grinder'"/>		
		</sequence>

		<sequence editable_state="true" name="'fbi_swat_ar'" triggable="true" once="true">						
			<set_variables var_gadgets_fbi_light="3"/>
			<run_sequence name="'gadget_meat_grinder'"/>		
		</sequence>

		<sequence editable_state="true" name="'fbi_shield'" triggable="true" once="true">						
			<set_variables var_gadgets_fbi_light="4"/>
			<run_sequence name="'gadget_meat_grinder'"/>		
		</sequence>
		
		<sequence editable_state="true" name="'heavy_swat_sg'" triggable="true" once="true">						
			<set_variables var_gadgets_blue_heavy="2"/>
			<run_sequence name="'gadget_meat_grinder'"/>		
		</sequence>

		<sequence editable_state="true" name="'heavy_swat_ar'" triggable="true" once="true">						
			<set_variables var_gadgets_blue_heavy="1"/>
			<run_sequence name="'gadget_meat_grinder'"/>		
		</sequence>
		
		<sequence editable_state="true" name="'fbi_heavy_swat_sg'" triggable="true" once="true">						
			<set_variables var_gadgets_blue_heavy="7"/>
			<body enabled="true" name="'body_plate'" />
			<decal_mesh enabled="true" name="'c_body_plate'" />										
			<run_sequence name="'gadget_meat_grinder'"/>		
		</sequence>

		<sequence editable_state="true" name="'fbi_heavy_swat_ar'" triggable="true" once="true">						
			<set_variables var_gadgets_blue_heavy="6"/>
			<body enabled="true" name="'body_plate'" />							
			<decal_mesh enabled="true" name="'c_body_plate'" />										
			<run_sequence name="'gadget_meat_grinder'"/>		
		</sequence>
		
		<sequence editable_state="true" name="'swat_sniper'" triggable="true" once="true">						
			<set_variables var_gadgets_blue_light="4"/>
			<run_sequence name="'gadget_meat_grinder'"/>		
		</sequence>

		<sequence editable_state="true" name="'fbi_swat_sniper'" triggable="true" once="true">						
			<set_variables var_gadgets_blue_light="5"/>
			<run_sequence name="'gadget_meat_grinder'"/>		
		</sequence>

		<sequence editable_state="true" name="'swat_shield'" triggable="true" once="true">						
			<set_variables var_gadgets_blue_heavy="3"/>
			<run_sequence name="'gadget_meat_grinder'"/>		
		</sequence>

		<sequence editable_state="true" name="'swat_taser'" triggable="true" once="true">						
			<set_variables var_gadgets_blue_heavy="4"/>
			<body enabled="true" name="'bag'" />				
			<run_sequence name="'gadget_meat_grinder'"/>		
		</sequence>
		<sequence editable_state="true" name="'swat_gren'" triggable="true" once="true">						
			<set_variables var_gadgets_blue_heavy="5"/>
			<run_sequence name="'gadget_meat_grinder'"/>		
			<body enabled="true" name="'bag_gren'" />	
		</sequence>
		
		<sequence editable_state="true" name="'awesomesfpd'" triggable="true" once="true">						
			<material_config name="'units/pd2_mod_lapd/characters/ene_swat_1/badasssf'"/>
		</sequence>
		
		<sequence editable_state="true" name="'awesometexpd'" triggable="true" once="true">						
			<material_config name="'units/pd2_mod_lapd/characters/ene_swat_1/badasstex'"/>
		</sequence>
		
		<sequence name="'detonate'" once="true">		
			<function extension="'character_damage'" function="'taser_bag_explode'" start_time="0"/>
			<body enabled="false" name="'bag'"/>
			<object enabled="false" name="'g_explosivebag_t'"/>			
			<decal_mesh enabled="false" name="'c_explosion'"/>
		</sequence>

		<sequence name="'detonate_fart'" once="true">		
			<function extension="'character_damage'" function="'grenadier_bag_explode'" start_time="0"/>
			<body enabled="false" name="'bag_gren'"/>
			<object enabled="false" name="'g_explosivebag'"/>			
			<object enabled="false" name="'g_explosivebag_lod1'"/>			
			<decal_mesh enabled="false" name="'c_explosion_gren'"/>
		</sequence>

		<sequence editable_state="true" name="'gadget_meat_grinder'" triggable="true" once="true">	
			<!-- GENERIC -->
			<!-- fbi ar -->
			<run_sequence filter="'check_fbi_ar'" name="'goggles_'..pick('a','a','b', 'c')"/>								
			<run_sequence filter="'check_fbi_ar'" name="'acc_'..pick('headset','headset','nothing')"/>								
			<object filter="'check_fbi_ar'" enabled="true" name="'g_swat_ar'"/>						
			<object filter="'check_fbi_ar'" enabled="true" name="'g_swat_ar_lod1'"/>
			<run_sequence filter="'check_fbi_ar'" name="'holster_'..pick('l','r', 'twinnem)"/>
			
			<!-- smg -->
			<run_sequence filter="'check_fbi_smg'" name="'goggles_'..pick('a','d','c')"/>								
			<run_sequence filter="'check_fbi_smg'" name="'acc_'..pick('headsets_random','headsets_random','nothing')"/>								
			<object filter="'check_fbi_smg'" enabled="true" name="'g_swat_smg'"/>						
			<object filter="'check_fbi_smg'" enabled="true" name="'g_swat_smg_lod1'"/>
			<object filter="'check_fbi_smg'" enabled="false" name="'g_helmet_lod1'"/>						
			<object filter="'check_fbi_smg'" enabled="false" name="'g_helmet_lod2'"/>
			<object filter="'check_fbi_smg'" enabled="true" name="'g_hat_lod1'"/>						
			<object filter="'check_fbi_smg'" enabled="true" name="'g_hat_lod2'"/>
			<run_sequence filter="'check_fbi_smg'" name="'holster_'..pick('l','r', 'twinnem)"/>
			<run_sequence filter="'check_fbi_smg'" name="'body_'..pick('nothing', 'nothing', 'shitbag')"/>
			<decal_mesh filter="'check_fbi_smg'" enabled="false" name="'dm_helmet'"/>					
	
			<!-- sg -->
			<object filter="'check_fbi_sg'" enabled="true" name="'g_swat_sg'"/>						
			<object filter="'check_fbi_sg'" enabled="false" name="'g_helmet_lod1'"/>						
			<object filter="'check_fbi_sg'" enabled="false" name="'g_helmet_lod2'"/>						
			<object filter="'check_fbi_sg'" enabled="true" name="'g_beanie_lod1'"/>						
			<object filter="'check_fbi_sg'" enabled="true" name="'g_beanie_lod2'"/>						
			<object filter="'check_fbi_sg'" enabled="true" name="'g_swat_sg_lod1'"/>	
			<run_sequence filter="'check_fbi_sg'" name="'goggles_'..pick('c','d','d', 'd' 'd')"/>											
			<run_sequence filter="'check_fbi_sg'" name="'body_'..pick('nothing', 'nothing', 'shitbag')"/>
			<run_sequence filter="'check_fbi_sg'" name="'holster_'..pick('l','r', 'twinnem)"/>
			<run_sequence filter="'check_fbi_sg'" name="'acc_'..pick('headsets_random','headsets_random','nothing')"/>								
			<decal_mesh filter="'check_fbi_sg'" enabled="false" name="'dm_helmet'"/>					

			<!-- smg -->
			<run_sequence filter="'check_blue_smg'" name="'goggles_'..pick('a','a','b')"/>								
			<run_sequence filter="'check_blue_smg'" name="'acc_'..pick('nothing','headset','nothing')"/>								
			<object filter="'check_blue_smg'" enabled="true" name="'g_swat_smg'"/>						
			<object filter="'check_blue_smg'" enabled="true" name="'g_swat_smg_lod1'"/>
			<run_sequence filter="'check_blue_smg'" name="'holster_'..pick('l','nothing')"/>
		
			<!-- sg -->
			<object filter="'check_blue_sg'" enabled="true" name="'g_swat_sg'"/>						
			<object filter="'check_blue_sg'" enabled="true" name="'g_swat_sg_lod1'"/>	
			<run_sequence filter="'check_blue_sg'" name="'goggles_'..pick('c','nothing','b', 'nothing' 'a')"/>											
			<run_sequence filter="'check_blue_sg'" name="'acc_pillow'"/>
			<run_sequence filter="'check_blue_sg'" name="'body_'..pick('nothing', 'nothing', 'shitbag')"/>
			<run_sequence filter="'check_blue_sg'" name="'holster_'..pick('l','nothing')"/>
			<run_sequence filter="'check_blue_sg'" name="'acc_'..pick('nothing','headset','nothing')"/>								
			
			<!-- heavy sg -->			
			<object filter="'check_blue_heavy_sg'" enabled="true" name="'g_swat_heavy_sg'"/>						
			<object filter="'check_blue_heavy_sg'" enabled="true" name="'g_swat_heavy_sg_lod1'"/>
			<run_sequence filter="'check_blue_heavy_sg'" name="'heavy_helmet_b'"/>
			<run_sequence filter="'check_blue_heavy_sg'" name="'body_'..pick('nothing', 'nothing', 'shitbag')"/>
			<run_sequence filter="'check_blue_heavy_sg'" name="'acc_'..pick('nothing','headset','nothing')"/>								

			<!-- rifleman -->			
			<object filter="'check_blue_ar'" enabled="true" name="'g_swat_ar'"/>						
			<object filter="'check_blue_ar'" enabled="true" name="'g_swat_ar_lod1'"/>
			<run_sequence filter="'check_blue_ar'" name="'goggles_'..pick('b','a','nothing', 'c')"/>								
			<run_sequence filter="'check_blue_ar'" name="'body_'..pick('nothing', 'nothing', 'shitbag')"/>
			<run_sequence filter="'check_blue_ar'" name="'body_'..pick('longsleeve', 'longsleeve', 'nothing')"/>
			<run_sequence filter="'check_blue_ar'" name="'acc_'..pick('nothing','pillow','nothing')"/>								
			<run_sequence filter="'check_blue_ar'" name="'holster_'..pick('l','nothing')"/>
			<run_sequence filter="'check_blue_ar'" name="'acc_'..pick('nothing','headset','nothing')"/>								

			<!-- heavy rifleman -->			
			<object filter="'check_blue_heavy_ar'" enabled="true" name="'g_swat_heavy_ar'"/>						
			<object filter="'check_blue_heavy_ar'" enabled="true" name="'g_swat_heavy_ar_lod1'"/>
			<run_sequence filter="'check_blue_heavy_ar'" name="'heavy_helmet_a'"/>
			<run_sequence filter="'check_blue_heavy_ar'" name="'body_'..pick('nothing', 'nothing', 'shitbag')"/>
			<run_sequence filter="'check_blue_heavy_ar'" name="'holster_'..pick('l','r', 'twinnem)"/>
			<run_sequence filter="'check_blue_heavy_ar'" name="'acc_'..pick('nothing','headset','nothing')"/>								
			<run_sequence filter="'check_blue_heavy_ar'" name="'body_'..pick('longsleeve', 'longsleeve', 'nothing')"/>

