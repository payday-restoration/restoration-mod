<?xml version="1.0"?><sequence_manager>	<unit>		<variables>			<var_role_light value="0" />			<var_role_heavy value="0" />			<var_goggles value="0" />			<var_visor value="0" />			<var_mask value="0" />		</variables>		<body name="'glass_swat'">			<endurance bullet="1" explosion="4">				<run_sequence name="'crk_glass'" />			</endurance>			<endurance bullet="3" explosion="6">				<run_sequence name="'destroy_glass'" />			</endurance>		</body>		<body name="'mask'">			<endurance bullet="2" explosion="4">				<run_sequence name="'destroy_mask'" />			</endurance>		</body>		<filter name="'check_goggles_a'">			<check value="vars.var_goggles == 1" />		</filter>		<filter name="'check_goggles_b'">			<check value="vars.var_goggles == 2" />		</filter>		<filter name="'check_goggles_c'">			<check value="vars.var_goggles == 3" />		</filter>		<filter name="'check_shades'">			<check value="vars.var_goggles == 4" />		</filter>		<filter name="'check_visor9'">			<check value="vars.var_visor == 9" />		</filter>		<filter name="'check_visor12'">			<check value="vars.var_visor == 12" />		</filter>		<filter name="'check_mask_shield'">			<check value="vars.var_mask == 1" />		</filter>		<filter name="'check_shield'">			<check value="vars.var_role_heavy == 3" />		</filter>		<!-- ===================== ROLES ===================== -->		<!-- ene_fbi_swat_3 - smg. No helmet of any kind. Headset always. -->		<sequence editable_state="true" name="'swat_smg'" triggable="true" once="true">			<set_variables var_role_light="1" var_role_heavy="0" />			<run_sequence name="'gloves_on'" />			<run_sequence name="'body_'..pick('default','b','default','short','b','default','b_short','default')" />			<run_sequence name="'gear_c'" />			<run_sequence name="'headset'" />			<run_sequence name="'accessory_'..pick('none', 'none', 'goggles_a','shades','goggles_c','none')" />			<run_sequence name="'holster_'..pick('r','r','r','r','l','l','twinnem')" />		</sequence>		<!-- ene_fbi_swat_2 - shotgunner. NVGs most of the time; 12/89/101112/1314 far rarer.		     Chance of mutton chops, very rare chance of the shield mask. -->		<sequence editable_state="true" name="'swat_sg'" triggable="true" once="true">			<set_variables var_role_light="2" var_role_heavy="0" />			<run_sequence name="'gloves_on'" />			<run_sequence name="'body_'..pick('short','short','b_short','b_short','b','b','default','default','default','b_short')" />			<run_sequence name="'gear_b'" />			<run_sequence name="'helmet_12'" />									<run_sequence name="'helmet_'..pick('nvg','nvg','nvg','nvg','nvg','nvg','nvg','nvg','nvg','12','89','101112','1314')" />			<run_sequence name="'addon_'..pick('muttons','muttons','muttons','none','none','none','none','none','none','none','none','shieldmask')" />			<run_sequence name="'accessory_'..pick('goggles_a','goggles_b','goggles_c','shades','none','none','none','none')" />			<run_sequence name="'holster_'..pick('r','r','r','r','l','l','twinnem')" />		</sequence>		<!-- ene_fbi_swat_1 - rifleman. Helmet 12 or 56. Headset or mutton chops. No goggles. -->		<sequence editable_state="true" name="'swat_ar'" triggable="true" once="true">			<set_variables var_role_light="3" var_role_heavy="0" />			<run_sequence name="'gloves_on'" />			<run_sequence name="'body_'..pick('short','short','b_short','b_short','b','b','default','default','default','b_short')" />			<run_sequence name="'gear_a'" />			<run_sequence name="'helmet_12'" />						<run_sequence name="'addon_'..pick('headset','muttons')" />						<run_sequence name="'helmet_'..pick('none','56')" />			<run_sequence name="'accessory_'..pick('goggles_a','goggles_b','goggles_c','shades','none','none')" />			<run_sequence name="'holster_'..pick('r','r','r','r','l','l','twinnem')" />		</sequence>		<!-- ene_shield_1 - helmet 12 plus the shield mask at all times. -->		<sequence editable_state="true" name="'swat_shield'" triggable="true" once="true">			<set_variables var_role_light="0" var_role_heavy="3" />			<run_sequence name="'gloves_on'" />			<run_sequence name="'gear_shield'" />			<run_sequence name="'helmet_12'" />			<run_sequence name="'helmet_shield_mask'" />			<run_sequence name="'holster_'..pick('r','r','r','l','twinnem')" />		</sequence>		<!-- Bare-headed, no helmet. -->		<sequence editable_state="true" name="'swat_sniper'" triggable="true" once="true">			<set_variables var_role_light="4" var_role_heavy="0" />			<run_sequence name="'gloves_on'" />			<run_sequence name="'body_'..pick('default','b','default','short','b','default','b_short','default')" />			<run_sequence name="'gear_a'" />			<run_sequence name="'accessory_'..pick('goggles_a','goggles_b','goggles_c','shades')" />			<run_sequence name="'holster_'..pick('r','r','r','r','l','l','twinnem')" />		</sequence>		<!-- ===================== BODY / GEAR ===================== -->		<sequence name="'gloves_on'" triggable="true">			<object enabled="true" name="'g_gloves'" />			<object enabled="true" name="'g_gloves_lod1'" />		</sequence>		<sequence name="'body_default'" triggable="true">			<object enabled="true" name="'g_body_fbi'" />			<object enabled="true" name="'g_body_fbi_lod1'" />		</sequence>		<sequence name="'body_b'" triggable="true">			<object enabled="true" name="'g_body_b_fbi'" />			<object enabled="true" name="'g_body_b_fbi_lod1'" />		</sequence>		<sequence name="'body_short'" triggable="true">			<object enabled="true" name="'g_body_short_fbi'" />			<object enabled="true" name="'g_body_short_fbi_lod1'" />		</sequence>		<sequence name="'body_b_short'" triggable="true">			<object enabled="true" name="'g_body_b_short_fbi'" />			<object enabled="true" name="'g_body_b_short_fbi_lod1'" />		</sequence>		<sequence name="'gear_a'" triggable="true">			<object enabled="true" name="'g_gear_fbi_swat_a'" />			<object enabled="true" name="'g_gear_fbi_swat_a_lod1'" />		</sequence>		<sequence name="'gear_b'" triggable="true">			<object enabled="true" name="'g_gear_fbi_swat_b'" />			<object enabled="true" name="'g_gear_fbi_swat_b_lod1'" />		</sequence>		<sequence name="'gear_c'" triggable="true">			<object enabled="true" name="'g_gear_fbi_swat_c'" />			<object enabled="true" name="'g_gear_fbi_swat_c_lod1'" />		</sequence>		<sequence name="'gear_shield'" triggable="true">			<object enabled="true" name="'g_swat_heavy_shield'" />			<object enabled="true" name="'g_swat_heavy_shield_lod1'" />		</sequence>		<!-- ===================== HELMETS ===================== -->		<!-- lod1 + lod2. Shield, rifleman and shotgunner. -->		<sequence name="'helmet_12'" triggable="true">			<object enabled="true" name="'g_helmet_fbi_swat_lod1'" />			<object enabled="true" name="'g_helmet_fbi_swat_lod2'" />			<decal_mesh enabled="true" name="'dm_helmet'" />		</sequence>		<!-- lod3 + lod4 - the NVG helmet. Shotgunner only. -->		<sequence name="'helmet_nvg'" triggable="true">			<object enabled="true" name="'g_helmet_fbi_swat_lod3'" />			<object enabled="true" name="'g_helmet_fbi_swat_lod4'" />			<decal_mesh enabled="true" name="'dm_helmet'" />		</sequence>		<!-- lod5 + lod6. Rifleman only. -->		<sequence name="'helmet_56'" triggable="true">			<object enabled="true" name="'g_helmet_fbi_swat_lod5'" />			<object enabled="true" name="'g_helmet_fbi_swat_lod6'" />			<decal_mesh enabled="true" name="'dm_helmet'" />		</sequence>		<!-- lod8 has no lods; lod9 is its glass. Shotgunner only. -->		<sequence name="'helmet_89'" triggable="true">			<object enabled="true" name="'g_helmet_fbi_swat_lod8'" />			<decal_mesh enabled="true" name="'dm_helmet'" />			<run_sequence name="'visor_9'" />		</sequence>		<!-- lod10 + lod11; lod12 is their glass. Shotgunner only. -->		<sequence name="'helmet_101112'" triggable="true">			<object enabled="true" name="'g_helmet_fbi_swat_lod10'" />			<object enabled="true" name="'g_helmet_fbi_swat_lod11'" />			<decal_mesh enabled="true" name="'dm_helmet'" />			<run_sequence name="'visor_12'" />		</sequence>		<!-- lod13 + lod14. Shotgunner only. -->		<sequence name="'helmet_1314'" triggable="true">			<object enabled="true" name="'g_helmet_fbi_swat_lod13'" />			<object enabled="true" name="'g_helmet_fbi_swat_lod14'" />			<decal_mesh enabled="true" name="'dm_helmet'" />		</sequence>		<!-- No helmet variant on top of the base helmet_12. -->		<sequence name="'helmet_none'" triggable="true">			<set_variables var_visor="0" />		</sequence>		<!-- lod15 + lod16 - mutton chops. -->		<sequence name="'helmet_muttons'" triggable="true">			<object enabled="true" name="'g_helmet_fbi_swat_lod15'" />			<object enabled="true" name="'g_helmet_fbi_swat_lod16'" />		</sequence>		<!-- The shield mask. Shield always; shotgunner very rarely. lod9 is its glass. -->		<sequence name="'helmet_shield_mask'" triggable="true">			<set_variables var_mask="1" />			<object enabled="true" name="'g_helmet_shield_lod1'" />			<object enabled="true" name="'g_helmet_shield_lod2'" />			<object enabled="true" name="'g_helmet_shield_lod9'" />			<body enabled="true" name="'mask'" />			<decal_mesh enabled="true" name="'c_mask'" />		</sequence>		<sequence name="'headset'" triggable="true">			<object enabled="true" name="'g_headset'" />			<object enabled="true" name="'g_headset_lod1'" />		</sequence>		<sequence name="'visor_9'" triggable="true">			<set_variables var_visor="9" />			<object enabled="true" name="'g_helmet_fbi_swat_lod9'" />			<body enabled="true" name="'glass_swat'" />			<decal_mesh enabled="true" name="'c_glass'" />		</sequence>		<sequence name="'visor_12'" triggable="true">			<set_variables var_visor="12" />			<object enabled="true" name="'g_helmet_fbi_swat_lod12'" />			<body enabled="true" name="'glass_swat'" />			<decal_mesh enabled="true" name="'c_glass'" />		</sequence>		<!-- ===================== HELMET ADD-ONS ===================== -->		<sequence name="'addon_headset'" triggable="true">			<run_sequence name="'headset'" />		</sequence>		<sequence name="'addon_muttons'" triggable="true">			<run_sequence name="'helmet_muttons'" />		</sequence>		<sequence name="'addon_shieldmask'" triggable="true">			<run_sequence name="'helmet_shield_mask'" />		</sequence>		<sequence name="'addon_none'" triggable="true">			<set_variables var_mask="0" />		</sequence>		<!-- ===================== ACCESSORIES ===================== -->		<sequence name="'accessory_none'" triggable="true">			<set_variables var_goggles="0" />		</sequence>		<sequence name="'accessory_goggles_a'" triggable="true">			<set_variables var_goggles="1" />			<object enabled="true" name="'g_goggles_a'" />			<object enabled="true" name="'g_goggles_a_lod1'" />			<object enabled="true" name="'g_goggles_glass_a'" />			<body enabled="true" name="'glass_swat'" />			<decal_mesh enabled="true" name="'c_glass'" />		</sequence>		<sequence name="'accessory_goggles_b'" triggable="true">			<set_variables var_goggles="2" />			<object enabled="true" name="'g_goggles_b'" />			<object enabled="true" name="'g_goggles_b_lod1'" />			<object enabled="true" name="'g_goggles_glass_b'" />			<body enabled="true" name="'glass_swat'" />			<decal_mesh enabled="true" name="'c_glass'" />		</sequence>		<sequence name="'accessory_goggles_c'" triggable="true">			<set_variables var_goggles="3" />			<object enabled="true" name="'g_goggles_c'" />			<object enabled="true" name="'g_goggles_c_lod1'" />			<object enabled="true" name="'g_glass'" />			<body enabled="true" name="'glass_swat'" />			<decal_mesh enabled="true" name="'c_glass'" />		</sequence>		<sequence name="'accessory_shades'" triggable="true">			<set_variables var_goggles="4" />			<object enabled="true" name="'g_shades'" />			<object enabled="true" name="'g_shades_lod1'" />			<object enabled="true" name="'g_shades_glass'" />		</sequence>		<!-- ===================== GLASS / MASK DAMAGE ===================== -->		<sequence name="'crk_glass'" triggable="true">			<object filter="'check_goggles_a'" enabled="false" name="'g_goggles_glass_a'" />			<object filter="'check_goggles_a'" enabled="true" name="'g_goggles_glass_a_crk'" />			<object filter="'check_goggles_b'" enabled="false" name="'g_goggles_glass_b'" />			<object filter="'check_goggles_b'" enabled="true" name="'g_goggles_glass_b_crk'" />			<object filter="'check_goggles_c'" enabled="false" name="'g_glass'" />			<object filter="'check_goggles_c'" enabled="true" name="'g_glass_crk'" />			<effect damp_time="5" name="'effects/particles/bullet_hit/glass_breakable/bullet_hit_glass_breakable'" parent="object( 'Head' )" position="v()" />		</sequence>		<sequence name="'destroy_glass'" triggable="true">			<object enabled="false" name="'g_glass'" />			<object enabled="false" name="'g_glass_crk'" />			<object enabled="false" name="'g_goggles_glass_a'" />			<object enabled="false" name="'g_goggles_glass_a_crk'" />			<object enabled="false" name="'g_goggles_glass_b'" />			<object enabled="false" name="'g_goggles_glass_b_crk'" />			<object enabled="false" name="'g_shades_glass'" />			<object filter="'check_visor9'" enabled="false" name="'g_helmet_fbi_swat_lod9'" />			<object filter="'check_visor12'" enabled="false" name="'g_helmet_fbi_swat_lod12'" />			<set_variables var_visor="0" />			<body enabled="false" name="'glass_swat'" />			<decal_mesh enabled="false" name="'c_glass'" />			<effect damp_time="5" name="'effects/particles/bullet_hit/glass_breakable/bullet_hit_glass_breakable'" parent="object( 'Head' )" position="v()" />		</sequence>		<sequence name="'destroy_mask'" triggable="true">			<object filter="'check_mask_shield'" enabled="false" name="'g_helmet_shield_lod9'" />			<set_variables var_mask="0" />			<body enabled="false" name="'mask'" />			<decal_mesh enabled="false" name="'c_mask'" />			<effect damp_time="5" name="'effects/particles/bullet_hit/glass_breakable/bullet_hit_glass_breakable'" parent="object( 'Head' )" position="v()" />		</sequence>		<!-- ===================== HELMET POP ===================== -->		<sequence editable_state="true" name="'spawn_helmet'" once="true" triggable="true">			<object enabled="false" name="'g_helmet_fbi_swat_lod1'" />			<object enabled="false" name="'g_helmet_fbi_swat_lod2'" />			<object enabled="false" name="'g_helmet_fbi_swat_lod3'" />			<object enabled="false" name="'g_helmet_fbi_swat_lod4'" />			<object enabled="false" name="'g_helmet_fbi_swat_lod5'" />			<object enabled="false" name="'g_helmet_fbi_swat_lod6'" />			<object enabled="false" name="'g_helmet_fbi_swat_lod8'" />			<object enabled="false" name="'g_helmet_fbi_swat_lod9'" />			<object enabled="false" name="'g_helmet_fbi_swat_lod10'" />			<object enabled="false" name="'g_helmet_fbi_swat_lod11'" />			<object enabled="false" name="'g_helmet_fbi_swat_lod12'" />			<object enabled="false" name="'g_helmet_fbi_swat_lod13'" />			<object enabled="false" name="'g_helmet_fbi_swat_lod14'" />			<object enabled="false" name="'g_helmet_fbi_swat_lod15'" />			<object enabled="false" name="'g_helmet_fbi_swat_lod16'" />			<object enabled="false" name="'g_helmet_shield_lod1'" />			<object enabled="false" name="'g_helmet_shield_lod2'" />			<object enabled="false" name="'g_helmet_shield_lod9'" />			<object enabled="false" name="'g_headset'" />			<object enabled="false" name="'g_headset_lod1'" />			<body enabled="false" name="'glass_swat'" />			<body enabled="false" name="'mask'" />			<decal_mesh enabled="false" name="'c_glass'" />			<decal_mesh enabled="false" name="'c_mask'" />			<decal_mesh enabled="false" name="'dm_helmet'" />			<set_variables var_visor="0" var_mask="0" />		</sequence>		<!-- ===================== HOLSTERS ===================== -->		<sequence name="'holster_l'" triggable="true">			<object enabled="true" name="'g_holster_l'" />			<object enabled="true" name="'g_holster_l_lod1'" />		</sequence>		<sequence name="'holster_r'" triggable="true">			<object enabled="true" name="'g_holster_r'" />			<object enabled="true" name="'g_holster_r_lod1'" />		</sequence>		<sequence name="'holster_twinnem'" triggable="true">			<object enabled="true" name="'g_holster_l'" />			<object enabled="true" name="'g_holster_l_lod1'" />			<object enabled="true" name="'g_holster_r'" />			<object enabled="true" name="'g_holster_r_lod1'" />		</sequence>		<sequence editable_state="true" name="'disable_hitbox'" triggable="true">			<body enabled="false" name="'body'" />			<body enabled="false" name="'head'" />			<body enabled="false" name="'rag_LeftLeg'" />			<body enabled="false" name="'rag_RightLeg'" />			<body enabled="false" name="'rag_RightUpLeg'" />			<body enabled="false" name="'rag_LeftUpLeg'" />		</sequence>		<sequence editable_state="true" name="'leg_arm_hitbox'" triggable="true">			<body enabled="true" name="'body'" />			<body enabled="true" name="'head'" />			<body enabled="false" motion="'keyframed'" name="'rag_Hips'" />			<body enabled="true" motion="'keyframed'" name="'rag_LeftUpLeg'" />			<body enabled="true" motion="'keyframed'" name="'rag_RightUpLeg'" />			<body enabled="true" motion="'keyframed'" name="'rag_LeftLeg'" />			<body enabled="true" motion="'keyframed'" name="'rag_RightLeg'" />			<body enabled="false" motion="'keyframed'" name="'rag_Spine'" />			<body enabled="false" motion="'keyframed'" name="'rag_Spine1'" />			<body enabled="false" motion="'keyframed'" name="'rag_Spine2'" />			<body enabled="false" motion="'keyframed'" name="'rag_LeftForeArm'" />			<body enabled="false" motion="'keyframed'" name="'rag_RightForeArm'" />			<body enabled="false" motion="'keyframed'" name="'rag_LeftArm'" />			<body enabled="false" motion="'keyframed'" name="'rag_RightArm'" />			<body enabled="false" motion="'keyframed'" name="'rag_Head'" />			<constraint enabled="false" name="'LeftUpLeg'" />			<constraint enabled="false" name="'RightUpLeg'" />			<constraint enabled="false" name="'LeftLeg'" />			<constraint enabled="false" name="'RightLeg'" />			<constraint enabled="false" name="'Spine'" />			<constraint enabled="false" name="'Spine1'" />			<constraint enabled="false" name="'Spine2'" />			<constraint enabled="false" name="'LeftForeArm'" />			<constraint enabled="false" name="'RightForeArm'" />			<constraint enabled="false" name="'LeftArm'" />			<constraint enabled="false" name="'RightArm'" />			<constraint enabled="false" name="'Head'" />		</sequence>		<sequence editable_state="true" name="'prepare_ragdoll'" triggable="true">			<body enabled="false" motion="'dynamic'" name="'rag_Hips'" />			<body enabled="false" motion="'dynamic'" name="'rag_LeftUpLeg'" />			<body enabled="false" motion="'dynamic'" name="'rag_RightUpLeg'" />			<body enabled="false" motion="'dynamic'" name="'rag_LeftLeg'" />			<body enabled="false" motion="'dynamic'" name="'rag_RightLeg'" />			<body enabled="false" motion="'dynamic'" name="'rag_Spine'" />			<body enabled="false" motion="'dynamic'" name="'rag_Spine1'" />			<body enabled="false" motion="'dynamic'" name="'rag_Spine2'" />			<body enabled="false" motion="'dynamic'" name="'rag_LeftForeArm'" />			<body enabled="false" motion="'dynamic'" name="'rag_RightForeArm'" />			<body enabled="false" motion="'dynamic'" name="'rag_LeftArm'" />			<body enabled="false" motion="'dynamic'" name="'rag_RightArm'" />			<body enabled="false" motion="'dynamic'" name="'rag_Head'" />		</sequence>		<sequence editable_state="true" name="'switch_to_ragdoll'" triggable="true">			<body enabled="false" name="'body'" />			<body enabled="false" name="'head'" />			<body enabled="true" motion="'dynamic'" name="'rag_Hips'" />			<body enabled="true" motion="'dynamic'" name="'rag_LeftUpLeg'" />			<body enabled="true" motion="'dynamic'" name="'rag_RightUpLeg'" />			<body enabled="true" motion="'dynamic'" name="'rag_LeftLeg'" />			<body enabled="true" motion="'dynamic'" name="'rag_RightLeg'" />			<body enabled="true" motion="'dynamic'" name="'rag_Spine'" />			<body enabled