<?xml version="1.0"?>
<dynamic_object>
	<diesel materials="units/payday2/characters/ene_bulldozer_2_sc/ene_bulldozer_2_sc" orientation_object="rp_ene_acc_bulldozer_helmet_plate" />
	
	<bodies>
	<body name="static_body" enabled="true" template="small_prop" pushed_by_mover="false" ang_damping="0.9">
			<object name="rp_ene_acc_bulldozer_helmet_plate" />
			<object name="c_helmet_plate" 	collision_type="convex" mass="1" />
		</body>
	</bodies>

	<decal_surfaces default_material="steel_no_decal">
	</decal_surfaces>

	<graphics>
			<lod_object name="bulldozer_helmet">
				<object name="g_helmet_plate" enabled="true" />
			</lod_object>
	</graphics>
	
</dynamic_object>