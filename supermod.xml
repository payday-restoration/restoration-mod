<?xml version="1.0"?>
<mod name="Restoration" global_key="restoration">

	<hooks script_path="supermod.lua">
		<group hook_id="lib/setups/">
			<post :hook_id="gamesetup"/>
			<post :hook_id="menusetup"/>
		</group>
	</hooks>
	<tweak definition="restorationmod_network_tweak.xml"/>
	<tweak definition="restorationmod_postprocessor_tweak.xml"/>
	<tweak definition="fps_animation_state_machine.xml" />
	<tweak definition="fps_animation_states.xml" />
	<tweak definition="fps_animation_subset.xml" />
	<tweak definition="std.animation_states"/>
	<tweak definition="std.animation_subset"/>

	<!-- Modify bundled decals without replacing the full asset. -->
	<tweak definition="restorationmod_decals_tweak.xml"/>

	<!-- Other asset declarations remain in the BeardLib packages/res/ files.
	     The setup hooks and animation/network tweak definitions remain above. -->

</mod>
