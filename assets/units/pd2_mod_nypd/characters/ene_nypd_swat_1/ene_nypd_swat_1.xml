<sequence_manager>
	<unit>
		<variables>
			
			<!-- heavy swat -->
			<var_gadgets_blue_heavy value="0"/>					
			
			<!-- blue swat -->
			<var_gadgets_blue_light value="0"/>					
			
			<!-- goggle a -->
			<var_goggles value="0"/>					
		</variables>
	
		<body name="'glass_swat'">
			<endurance bullet="1" explosion="4">
				<run_sequence name="'crk_goggles'"/>
			</endurance>
		</body>	
	
		<body name="'glass_l'">
			<endurance bullet="1" explosion="4">
				<run_sequence name="'crk_glass_l'"/>
			</endurance>
		</body>	

		<body name="'glass_r'">
			<endurance bullet="1" explosion="4">
				<run_sequence name="'crk_glass_r'"/>
			</endurance>
		</body>	

	
		<body name="'bag'">
			<endurance damage="36" >
				<run_sequence name="'detonate'"/>
			</endurance>
		</body>	
		
		<body name="'bag_gren'">
			<endurance damage="36" >
				<run_sequence name="'detonate_fart'"/>
			</endurance>
		</body>	
	
		<body name="'glass_visor'">
			<endurance bullet="2" explosion="4">
				<run_sequence name="'crk_visor'"/>
			</endurance>
			<endurance explosion="6">
				<run_sequence name="'destroy_visor'"/>
			</endurance>
		</body>	

		<body name="'glass_shield'">
			<endurance bullet="2" explosion="4">
				<run_sequence name="'crk_visor'"/>
			</endurance>
			<endurance explosion="6">
				<run_sequence name="'destroy_visor'"/>
			</endurance>
		</body>	

		<filter name="'check_blue_heavy_ar'">
			<check value="vars.var_gadgets_blue_heavy == 1"/>
		</filter>
		<filter name="'check_blue_heavy_sg'">
			<check value="vars.var_gadgets_blue_heavy == 2"/>
		</filter>
		<filter name="'check_blue_heavy_shield'">
			<check value="vars.var_gadgets_blue_heavy == 3"/>
		</filter>
		<filter name="'check_blue_taser'">
			<check value="vars.var_gadgets_blue_heavy == 4"/>
		</filter>
		<filter name="'check_blue_gren'">
			<check value="vars.var_gadgets_blue_heavy == 5"/>
		</filter>
		
		<filter name="'check_blue_medic'">
			<check value="vars.var_gadgets_blue_heavy == 6"/>
		</filter>
		
		<filter name="'check_blue_cloaca'">
			<check value="vars.var_gadgets_blue_heavy == 7"/>
		</filter>

		<filter name="'check_blue_smg'">
			<check value="vars.var_gadgets_blue_light == 1"/>
		</filter>
		
		<filter name="'check_blue_sg'">
			<check value="vars.var_gadgets_blue_light == 2"/>
		</filter>

		<filter name="'check_goggle_a'">
			<check value="vars.var_goggles == 1"/>
		</filter>

		<filter name="'check_goggle_b'">
			<check value="vars.var_goggles == 2"/>
		</filter>
		
		<filter name="'check_blue_ar'">
			<check value="vars.var_gadgets_blue_light == 3"/>
		</filter>
		
		<filter name="'check_blue_sniper'">
			<check value="vars.var_gadgets_blue_light == 4"/>
		</filter>
		

		<sequence editable_state="true" name="'swat_smg'" triggable="true" once="true">						
			<set_variables var_gadgets_blue_light="1"/>
			<run_sequence name="'gadget_meat_grinder'"/>		
		</sequence>

		<sequence editable_state="true" name="'swat_sg'" triggable="true" once="true">						
			<set_variables var_gadgets_blue_light="2"/>
			<run_sequence name="'gadget_meat_grinder'"/>		
		</sequence>

		<sequence editable_state="true" name="'swat_ar'" triggable="true" once="true">						
			<set_variables var_gadgets_blue_light="3"/>
			<run_sequence name="'gadget_meat_grinder'"/>		
		</sequence>
		
		<sequence editable_state="true" name="'swat_medic'" triggable="true" once="true">						
			<set_variables var_gadgets_blue_heavy="6"/>
			<run_sequence name="'gadget_meat_grinder'"/>		
		</sequence>
		

		<sequence editable_state="true" name="'swat_sniper'" triggable="true" once="true">						
			<set_variables var_gadgets_blue_light="4"/>
			<run_sequence name="'gadget_meat_grinder'"/>		
		</sequence>

		<sequence editable_state="true" name="'swat_gren'" triggable="true" once="true">						
			<set_variables var_gadgets_blue_heavy="5"/>
			<run_sequence name="'gadget_meat_grinder'"/>		
			<body enabled="true" name="'bag_gren'" />	
			
		</sequence>

		<sequence editable_state="true" name="'swat_cloaca'" triggable="true" once="true">						
			<set_variables var_gadgets_blue_heavy="7"/>
			<run_sequence name="'gadget_meat_grinder'"/>					
		</sequence>

		<sequence editable_state="true" name="'swat_taser'" triggable="true" once="true">						
			<set_variables var_gadgets_blue_heavy="4"/>
			<body enabled="true" name="'bag'" />				
			<run_sequence name="'gadget_meat_grinder'"/>		
		</sequence>

		<sequence editable_state="true" name="'swat_shield'" triggable="true" once="true">						
			<set_variables var_gadgets_blue_heavy="3"/>
			<run_sequence name="'gadget_meat_grinder'"/>		
		</sequence>

		<sequence editable_state="true" name="'heavy_swat_sg'" triggable="true" once="true">						
			<set_variables var_gadgets_blue_heavy="2"/>
			<run_sequence name="'gadget_meat_grinder'"/>		
		</sequence>

		<sequence editable_state="true" name="'heavy_swat_ar'" triggable="true" once="true">						
			<set_variables var_gadgets_blue_heavy="1"/>
			<run_sequence name="'gadget_meat_grinder'"/>		
		</sequence>
		
		<sequence editable_state="true" name="'gadget_meat_grinder'" triggable="true" once="true">	
			<!-- GENERIC -->
			<run_sequence filter="'check_blue_smg'" name="'holster_'..pick('r','r','r','r','l','l','twinnem')"/>
			<run_sequence filter="'check_blue_sg'" name="'holster_'..pick('r','r','r','r','l','l','twinnem')"/>
			<run_sequence filter="'check_blue_ar'" name="'holster_'..pick('r','r','r','r','l','l','twinnem')"/>
			<run_sequence filter="'check_blue_heavy_ar'" name="'holster_'..pick('r','r','r','r','l','l','twinnem')"/>
			<run_sequence filter="'check_blue_taser'" name="'holster_'..pick('r','r','r','r','l','l','twinnem')"/>
			<run_sequence filter="'check_blue_heavy_sg'" name="'holster_'..pick('r','r','r','r','l','l','twinnem')"/>
			
			<!-- smg -->
			<object filter="'check_blue_smg'" enabled="true" name="'g_swat_smg'"/>						
			<object filter="'check_blue_smg'" enabled="true" name="'g_swat_smg_lod1'"/>
		
			<!-- sg -->
			<object filter="'check_blue_sg'" enabled="true" name="'g_swat_sg'"/>
			<object filter="'check_blue_sg'" enabled="true" name="'g_swat_sg_lod1'"/>								
			<run_sequence filter="'check_blue_sg'" name="'goggles_'..pick('a','a','b')"/>											

			<!-- rifleman -->			
			<object filter="'check_blue_ar'" enabled="true" name="'g_swat_ar'"/>						
			<object filter="'check_blue_ar'" enabled="true" name="'g_swat_ar_lod1'"/>

			<!-- medic -->			
			<object filter="'check_blue_medic'" enabled="true" name="'g_body_medic'"/>						
			<object filter="'check_blue_medic'" enabled="true" name="'g_body_medic_lod1'"/>
			<object filter="'check_blue_medic'" enabled="false" name="'g_helmet_lod1'"/>						
			<object filter="'check_blue_medic'" enabled="false" name="'g_helmet_lod2'"/>
			<object filter="'check_blue_medic'" enabled="true" name="'g_helmet_medic_lod1'"/>						
			<object filter="'check_blue_medic'" enabled="true" name="'g_helmet_medic_lod2'"/>
			<object filter="'check_blue_medic'" enabled="false" name="'g_body'"/>						
			<object filter="'check_blue_medic'" enabled="false" name="'g_body_lod1'"/>

			<!-- heavy rifleman -->			
			<object filter="'check_blue_heavy_ar'" enabled="true" name="'g_swat_ar'"/>						
			<object filter="'check_blue_heavy_ar'" enabled="true" name="'g_swat_ar_lod1'"/>

			<!-- heavy sg -->	
			<object filter="'check_blue_heavy_sg'" enabled="true" name="'g_helmet_lod5'"/>									
			<object filter="'check_blue_heavy_sg'" enabled="true" name="'g_swat_sg'"/>						
			<object filter="'check_blue_heavy_sg'" enabled="true" name="'g_swat_sg_lod1'"/>

			<!-- shield -->			
			<object filter="'check_blue_heavy_shield'" enabled="true" name="'g_swat_shield'"/>						
			<object filter="'check_blue_heavy_shield'" enabled="true" name="'g_swat_shield_lod1'"/>
			<run_sequence filter="'check_blue_heavy_shield'" name="'heavy_helmet_c'"/>
			
			<!-- gren -->			
			<object filter="'check_blue_gren'" enabled="false" name="'g_helmet_lod1'"/>						
			<object filter="'check_blue_gren'" enabled="false" name="'g_helmet_lod2'"/>
			<object filter="'check_blue_gren'" enabled="false" name="'g_body'"/>						
			<object filter="'check_blue_gren'" enabled="false" name="'g_body_lod1'"/>
			<object filter="'check_blue_gren'" enabled="true" name="'g_body_grenadier'"/>						
			<object filter="'check_blue_gren'" enabled="true" name="'g_body_grenadier_lod1'"/>
			<object filter="'check_blue_gren'" enabled="true" name="'g_explosivebag'"/>						
			<object filter="'check_blue_gren'" enabled="true" name="'g_explosivebag_lod1'"/>
			<run_sequence filter="'check_blue_gren'" name="'heavy_helmet_d'"/>											
			<decal_mesh filter="'check_blue_gren'" enabled="true" name="'c_mask_taser'"/>					

			<!-- taser -->			
			<object filter="'check_blue_taser'" enabled="false" name="'g_helmet_lod1'"/>						
			<object filter="'check_blue_taser'" enabled="false" name="'g_helmet_lod2'"/>
			<object filter="'check_blue_taser'" enabled="false" name="'g_body'"/>						
			<object filter="'check_blue_taser'" enabled="false" name="'g_body_lod1'"/>
			<object filter="'check_blue_taser'" enabled="true" name="'g_explosivebag_t'"/>												
			<object filter="'check_blue_taser'" enabled="true" name="'g_body_taser'"/>	
			<object filter="'check_blue_taser'" enabled="true" name="'g_body_taser_lod1'"/>
			<run_sequence filter="'check_blue_taser'" name="'heavy_helmet_c'"/>		
			
			<!-- claoca -->			
			<object filter="'check_blue_cloaca'" enabled="true" name="'g_body_cloaker'"/>	
			<object filter="'check_blue_cloaca'" enabled="true" name="'g_il'"/>	
			<object filter="'check_blue_cloaca'" enabled="true" name="'g_body_cloaker_lod1'"/>
			<decal_mesh filter="'check_blue_cloaca'" enabled="false" name="'dm_helmet'"/>					
			<decal_mesh filter="'check_blue_cloaca'" enabled="true" name="'c_mask_taser'"/>					
						
			<!-- sniper -->			
			<object filter="'check_blue_sniper'" enabled="true" name="'g_body_sniper'"/>						
			<object filter="'check_blue_sniper'" enabled="true" name="'g_body_sniper_lod1'"/>
			<object filter="'check_blue_sniper'" enabled="false" name="'g_helmet_lod1'"/>						
			<object filter="'check_blue_sniper'" enabled="false" name="'g_helmet_lod2'"/>
			<object filter="'check_blue_sniper'" enabled="false" name="'g_body'"/>						
			<object filter="'check_blue_sniper'" enabled="false" name="'g_body_lod1'"/>
			<object filter="'check_blue_sniper'" enabled="true" name="'g_hat_lod1'"/>
			<object filter="'check_blue_sniper'" enabled="true" name="'g_hat_lod2'"/>					
			<decal_mesh filter="'check_blue_sniper'" enabled="false" name="'dm_helmet'"/>					
			<run_sequence filter="'check_blue_sniper'" name="'head_'..pick('a','b','c', 'balaclava')"/>
			
		</sequence>

		<sequence editable_state="true" name="'spawn_helmet'" once="true" triggable="true">
			<decal_mesh filter="'check_goggle_b'" enabled="false" name="'c_glass'" />										
			<object filter="'check_goggle_b'" enabled="false" name="'g_glass'" />										
			<object filter="'check_goggle_b'" enabled="false" name="'g_helmet_lod3'" />										
			<object filter="'check_goggle_b'" enabled="false" name="'g_glass_crk'" />										
			<body filter="'check_goggle_b'" enabled="false" name="'glass_swat'" />	
									
			<decal_mesh enabled="false" name="'c_glass'" />										
			<decal_mesh enabled="false" name="'c_glass_shield'" />										
									
			<body enabled="false" name="'glass_shield'" />	
			<run_sequence filter="'check_blue_heavy_ar'" name="'destroy_visor'"/>						
			<run_sequence filter="'check_blue_gren'" name="'destroy_visor'"/>						
			<run_sequence filter="'check_blue_heavy_sg'" name="'destroy_visor'"/>						
		</sequence>

		<!-- RANDOM HELMETS/GOGGLES -->
		<!-- HEAVY HELMET 'B' DEFAULT WITH DIFFERENT VISOR -->		
		<sequence editable_state="true" name="'heavy_helmet_b'" once="true" triggable="true">
			<object enabled="true" name="'g_helmet_lod5'"/>
		</sequence>
		
		<!-- HEAVY HELMET 'C' SHIELD -->
		<sequence editable_state="true" name="'heavy_helmet_c'" once="true" triggable="true">
			<object enabled="true" name="'g_helmet_mask_lod1'"/>
			<object enabled="true" name="'g_helmet_mask_lod2'"/>
			<object enabled="false" name="'g_helmet_lod1'"/>
			<object enabled="false" name="'g_helmet_lod2'"/>
			<object enabled="false" name="'g_helmet_lod3'"/>
			<decal_mesh enabled="true" name="'c_mask_taser'" />										
			<decal_mesh enabled="false" name="'c_glass_shield'" />										
			<body enabled="false" name="'glass_swat'" />										
			<body enabled="true" name="'sg_mask'" />										
		</sequence>
		
		<sequence editable_state="true" name="'heavy_helmet_d'" once="true" triggable="true">
			<object enabled="false" name="'g_helmet_lod1'"/>
			<object enabled="false" name="'g_helmet_lod2'"/>
			<object enabled="false" name="'g_helmet_lod3'"/>
			<object enabled="true" name="'g_helmet_grenadier_lod1'" />										
			<object enabled="true" name="'g_helmet_grenadier_lod2'" />				
			<object enabled="true" name="'g_glass_l'" />										
			<object enabled="true" name="'g_glass_r'" />							
			<decal_mesh enabled="true" name="'c_mask_taser'" />										
			<decal_mesh enabled="true" name="'c_glass_l'" />										
			<decal_mesh enabled="true" name="'c_glass_r'" />										
			<decal_mesh enabled="false" name="'c_glass_shield'" />										
			<body enabled="false" name="'glass_swat'" />										
			<body enabled="true" name="'sg_mask'" />										
			<body enabled="true" name="'glass_l'" />										
			<body enabled="true" name="'glass_r'" />	
			<object enabled="true" name="'g_helmet_grenadier_lod1'" />										
			<object enabled="true" name="'g_helmet_grenadier_lod2'" />				
		</sequence>


		<sequence name="'detonate'" once="true">		
			<function extension="'character_damage'" function="'taser_bag_explode'" start_time="0"/>
			<body enabled="false" name="'bag'"/>
			<object enabled="false" name="'g_explosivebag_t'"/>			
			<decal_mesh enabled="false" name="'dm_explosion'"/>
		</sequence>

		<sequence name="'detonate_fart'" once="true">		
			<function extension="'character_damage'" function="'grenadier_bag_explode'" start_time="0"/>
			<body enabled="false" name="'bag_gren'"/>
			<object enabled="false" name="'g_explosivebag'"/>			
			<object enabled="false" name="'g_explosivebag_lod1'"/>			
			<decal_mesh enabled="false" name="'dm_explosion'"/>
		</sequence>

		<sequence editable_state="true" name="'crk_visor'" once="true" triggable="true">			
			<object enabled="false" name="'g_helmet_lod3'"/>
			<object enabled="true" name="'g_helmet_lod4'"/>
			<effect damp_time="5" name="'effects/particles/bullet_hit/glass_breakable/bullet_hit_glass_breakable'" parent="object( 'Head' )" position="v()"/>			
		</sequence>				

		<sequence editable_state="true" name="'destroy_visor'" once="true" triggable="true">			
			<body  	enabled="false" name="'glass_shield'"/>
			<body  	enabled="false" name="'glass_l'"/>
			<body  	enabled="false" name="'glass_r'"/>
			<object enabled="false" name="'g_helmet_lod3'"/>
			<object enabled="false" name="'g_helmet_lod4'"/>
			<object enabled="false" name="'g_glass_l'"/>
			<object enabled="false" name="'g_glass_r'"/>
			<object enabled="false" name="'g_glass_l_crk'"/>
			<object enabled="false" name="'g_glass_r_crk'"/>
			<decal_mesh enabled="false" name="'c_glass_shield'" />					
			<decal_mesh enabled="false" name="'c_glass_l'" />					
			<decal_mesh enabled="false" name="'c_glass_r'" />								
			<effect damp_time="5" name="'effects/particles/bullet_hit/glass_breakable/bullet_hit_glass_breakable'" parent="object( 'Head' )" position="v()"/>
			<effect damp_time="5" name="'effects/particles/bullet_hit/glass_breakable/bullet_hit_glass_breakable'" parent="object( 'Head' )" position="v()"/>
			<sound action="'play'" event="'swat_heavy_visor_shatter'" object="'Head'"/>			
			<sound action="'play'" event="'swat_heavy_visor_shatter'" object="'Head'"/>			
		</sequence>				
		
		<sequence editable_state="true" name="'goggles_a'" once="true" triggable="true">
			<object enabled="true" name="'g_goggles_a'"/>
			<object enabled="true" name="'g_goggles_a_lod1'"/>
			<object enabled="true" name="'g_glass'"/>
			<set_variables var_goggles="1"/>					
			<decal_mesh enabled="true" name="'c_glass'" />					
			<body enabled="true" name="'glass_swat'" />					
		</sequence>

		<sequence editable_state="true" name="'crk_goggles'" once="true" triggable="true">
			<object enabled="true" name="'g_glass_crk'"/>
			<object enabled="false" name="'g_glass'"/>
		</sequence>				
		
		<sequence editable_state="true" name="'goggles_b'" once="true" triggable="true">
			<object enabled="true" name="'g_helmet_lod3'"/>
			<object enabled="true" name="'g_helmet_lod4'"/>
			<object enabled="true" name="'g_glass'"/>
			
			<set_variables var_goggles="2"/>										
			<decal_mesh enabled="true" name="'c_glass'" />					
			<body enabled="true" name="'glass_swat'" />										
		</sequence>

		<sequence editable_state="true" name="'goggles_c'" once="true" triggable="true">
			<object enabled="true" name="'g_helmet_lod7'"/>
			<object enabled="true" name="'g_helmet_lod8'"/>
		</sequence>
		
		<sequence editable_state="true" name="'crk_glass_l'" once="true" triggable="true">
			<object enabled="false" name="'g_glass_l'"/>
			<object enabled="true" name="'g_glass_l_crk'"/>
		</sequence>
		<sequence editable_state="true" name="'crk_glass_r'" once="true" triggable="true">
			<object enabled="false" name="'g_glass_r'"/>
			<object enabled="true" name="'g_glass_r_crk'"/>
		</sequence>
		<!-- RANDOM HELMETS end -->
						
		<!-- RANDOM HOLSTERS -->
		<sequence editable_state="true" name="'holster_l'" once="true" triggable="true">
			<object enabled="true" name="'g_holster_l'"/>
			<object enabled="true" name="'g_holster_l_lod1'"/>
			<object enabled="false" name="'g_holster_r'"/>
			<object enabled="false" name="'g_holster_r_lod1'"/>
		</sequence>

		<sequence editable_state="true" name="'holster_r'" once="true" triggable="true">
			<object enabled="true" name="'g_holster_l'"/>
			<object enabled="true" name="'g_holster_l_lod1'"/>
		</sequence>																

		<sequence editable_state="true" name="'holster_twinnem'" once="true" triggable="true">
			<object enabled="true" name="'g_holster_l'"/>
			<object enabled="true" name="'g_holster_l_lod1'"/>
			<object enabled="true" name="'g_holster_r'"/>
			<object enabled="true" name="'g_holster_r_lod1'"/>
		</sequence>								
		<!-- RANDOM HOLSTERS end -->

		<!-- BALACLAVA W/ "INSIDE" FACE SEQUENCES -->
		<sequence editable_state="true" name="'head_balaclava'" triggable="true" once="true">	
			<object enabled="true" name="'g_balaclava'"/>
			<object enabled="true" name="'g_balaclava_lod1'"/>	

			<run_sequence name="'face_'..pick('a','b','c','d','e')" />										
		</sequence>								
		
		<sequence editable_state="true" name="'face_a'" once="true" triggable="true">
			<object enabled="true" name="'g_face_a'"/>
			<object enabled="true" name="'g_face_a_lod1'"/>
		</sequence>								
		<sequence editable_state="true" name="'face_b'" once="true" triggable="true">
			<object enabled="true" name="'g_face_b'"/>
			<object enabled="true" name="'g_face_b_lod1'"/>
		</sequence>								
		<sequence editable_state="true" name="'face_c'" once="true" triggable="true">
			<object enabled="true" name="'g_face_c'"/>
			<object enabled="true" name="'g_face_c_lod1'"/>
		</sequence>								
		<sequence editable_state="true" name="'face_d'" once="true" triggable="true">
			<object enabled="true" name="'g_face_d'"/>
			<object enabled="true" name="'g_face_d_lod1'"/>
		</sequence>								
		<sequence editable_state="true" name="'face_e'" once="true" triggable="true">
			<object enabled="true" name="'g_face_e'"/>
			<object enabled="true" name="'g_face_e_lod1'"/>
		</sequence>	
		<!-- END BALACALVA FACES -->
		
		<sequence editable_state="false" name="'kill_spook_lights'" triggable="false">
			<effect_spawner enabled="false" name="'es_light'"/>
			<light enabled="false" name="'point_light'"/>
			<object enabled="false" name="'g_il'"/>
		</sequence>
		
		<sequence editable_state="false" name="'turn_on_spook_lights'" triggable="false">
			<effect_spawner enabled="true" name="'es_light'"/>
			<light enabled="true" name="'point_light'"/>
			<object enabled="true" name="'g_il'"/>
		</sequence>

		<!-- EXPOSED HEAD SEQUENCES -->				
		<sequence editable_state="true" name="'head_a'" once="true" triggable="true">
			<object enabled="true" name="'g_head_a'"/>
			<object enabled="true" name="'g_head_a_lod1'"/>
		</sequence>								
		<sequence editable_state="true" name="'head_b'" once="true" triggable="true">
			<object enabled="true" name="'g_head_b'"/>
			<object enabled="true" name="'g_head_b_lod1'"/>
		</sequence>								
		<sequence editable_state="true" name="'head_c'" once="true" triggable="true">
			<object enabled="true" name="'g_head_c'"/>
			<object enabled="true" name="'g_head_c_lod1'"/>
		</sequence>	
	
		<sequence editable_state="true" name="'disable_hitbox'" triggable="true">
