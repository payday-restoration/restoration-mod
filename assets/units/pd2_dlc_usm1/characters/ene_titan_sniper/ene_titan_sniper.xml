<sequence_manager>
	<unit>
		<variables>
			
			<var_gadgets_swat value="0"/>					
						
			<var_goggles value="0"/>					
		</variables>
		
		<body name="'glass_swat'">
			<endurance explosion="4" bullet="1">
				<run_sequence name="'crk_goggles'"/>
			</endurance>
		</body>	
			
		<body name="'glass_visor'">
			<endurance bullet="2" explosion="4">
				<run_sequence name="'crk_visor'"/>
			</endurance>
			<endurance explosion="6">
				<run_sequence name="'destroy_visor'"/>
			</endurance>
		</body>	

		<body name="'glass_shield'">
			<endurance bullet="2" explosion="4">
				<run_sequence name="'crk_visor'"/>
			</endurance>
			<endurance explosion="6">
				<run_sequence name="'destroy_visor'"/>
			</endurance>
		</body>	
		
		<filter name="'check_helmet'">
			<check value="vars.var_gadgets_swat > 2"/>
		</filter>

		<filter name="'check_swat_sniper'">
			<check value="vars.var_gadgets_swat == 1"/>
		</filter>
		<filter name="'check_swat_smg'">
			<check value="vars.var_gadgets_swat == 2"/>
		</filter>
		<filter name="'check_swat_ar'">
			<check value="vars.var_gadgets_swat == 3"/>
		</filter>
		<filter name="'check_swat_shield'">
			<check value="vars.var_gadgets_swat == 4"/>
		</filter>
		<filter name="'check_taser'">
			<check value="vars.var_gadgets_swat == 5"/>
		</filter>
		<filter name="'check_swat_ar_titan'">
			<check value="vars.var_gadgets_swat == 6"/>
		</filter>
		<filter name="'check_swat_sg_titan'">
			<check value="vars.var_gadgets_swat == 7"/>
		</filter>

		<filter name="'check_goggle_a'">
			<check value="vars.var_goggles == 1"/>
		</filter>

		<filter name="'check_goggle_b'">
			<check value="vars.var_goggles == 2"/>
		</filter>
		
		
		<sequence editable_state="true" name="'swat_sniper'" triggable="true" once="true">						
			<set_variables var_gadgets_swat="1"/>
			<run_sequence filter="'check_swat_sniper'" name="'goggles_'..pick('c', 'c', 'c', 'c', 'a', 'd', 'c','c','c', 'nothing', 'c')"/>								
			<run_sequence name="'gadget_meat_grinder'"/>		
		</sequence>
						
		<sequence editable_state="true" name="'swat_smg'" triggable="true" once="true">						
			<set_variables var_gadgets_swat="2"/>
			<run_sequence name="'gadget_meat_grinder'"/>		
		</sequence>
		
		<sequence editable_state="true" name="'swat_ar'" triggable="true" once="true">						
			<set_variables var_gadgets_swat="3"/>
			<run_sequence name="'gadget_meat_grinder'"/>		
		</sequence>
	
		<sequence editable_state="true" name="'swat_shield'" triggable="true" once="true">						
			<set_variables var_gadgets_swat="4"/>
			<run_sequence name="'gadget_meat_grinder'"/>		
		</sequence>

		<sequence editable_state="true" name="'taser_titan'" triggable="true" once="true">						
			<set_variables var_gadgets_swat="5"/>
			<run_sequence name="'gadget_meat_grinder'"/>		
		</sequence>
		
		<sequence editable_state="true" name="'swat_ar_titan'" triggable="true" once="true">						
			<set_variables var_gadgets_swat="6"/>
			<run_sequence name="'gadget_meat_grinder'"/>		
		</sequence>
		
		<sequence editable_state="true" name="'swat_sg_titan'" triggable="true" once="true">						
			<set_variables var_gadgets_swat="7"/>
			<run_sequence name="'gadget_meat_grinder'"/>		
		</sequence>
		
		<sequence editable_state="true" name="'swap_bellmead'" triggable="true" once="true">						
			<run_sequence name="'gadget_meat_grinder'"/>
			<material_config name="'units/pd2_dlc_usm1/characters/ene_marshal_marksman_2/ene_marshal_marksman_2'"/>									
			<object enabled="false" name="'g_swat_sniper'"/>									
			<object enabled="false" name="'g_hat_lod3'"/>									
			<object enabled="false" name="'g_swat_sniper_lod1'"/>
			<run_sequence filter="'check_swat_sniper'" name="'goggles_'..pick('d', 'd', 'd', 'd', 'a', 'nothing', 'c','c','c', 'nothing', 'd')"/>											
			<object filter="'check_swat_sniper'" enabled="true" name="'g_swat_sniper_bellmead'"/>									
			<object filter="'check_swat_sniper'" enabled="true" name="'g_swat_sniper_bellmead_lod1'"/>									
			<object filter="'check_swat_sniper'" enabled="false" name="'g_swat_sniper'"/>									
			<object filter="'check_swat_sniper'" enabled="false" name="'g_swat_sniper_lod1'"/>									
		</sequence>
				

		<sequence editable_state="true" name="'gadget_meat_grinder'" triggable="true" once="true">	
			<!-- GENERIC -->
			<run_sequence  name="'acc_'..pick('gloves','gloves', 'gloves', 'nothing', 'nothing',)"/>
			
			<!-- rifleman segurity for bellmead :DDDDD -->
			<run_sequence  filter="'check_swat_ar'" name="'holster_'..pick('r','r','r','r','l','l','twinnem')"/>
			<run_sequence  filter="'check_swat_ar'" name="'acc_'..pick('headsets','earpiece', 'jackshit', 'headsets', 'headsets',)"/>
			<run_sequence filter="'check_swat_ar'" name="'goggles_'..pick('a', 'a', 'a', 'a', 'a', 'b', 'c')"/>					
			<object filter="'check_swat_ar'" enabled="true" name="'g_security_2'"/>						
			<object filter="'check_swat_ar'" enabled="true" name="'g_security_2_lod1'"/>
			<object filter="'check_swat_ar'" enabled="true" name="'g_helmet_lod1'"/>						
			<decal_mesh filter="'check_swat_ar'" enabled="true" name="'dm_helmet'"/>						
			<object filter="'check_swat_ar'" enabled="true" name="'g_helmet_lod2'"/>
			
			<!-- smg segurity for bellmead :DDDDD -->
			<run_sequence  filter="'check_swat_smg'" name="'holster_'..pick('r','r','r','r','l','l','twinnem')"/>
			<run_sequence  filter="'check_swat_smg'" name="'acc_'..pick('earpiece','earpiece', 'jackshit', 'jackshit', 'jackshit',)"/>
			<run_sequence filter="'check_swat_smg'" name="'goggles_'..pick('a', 'a', 'a', 'a', 'a', 'b', 'c')"/>					
			<run_sequence  filter="'check_swat_smg'" name="'body_'..pick('shitbag', 'nothing', 'shitbag')"/>
			<object filter="'check_swat_smg'" enabled="true" name="'g_security_1'"/>						
			<object filter="'check_swat_smg'" enabled="true" name="'g_security_1_lod1'"/>
					
			<!-- shield -->			
			<object filter="'check_swat_shield'" enabled="true" name="'g_shield'"/>						
			<object filter="'check_swat_shield'" enabled="true" name="'g_shield_lod1'"/>
			<run_sequence filter="'check_swat_shield'" name="'heavy_helmet_b'"/>
			<run_sequence  filter="'check_swat_shield'" name="'acc_'..pick('headsets','earpiece', 'jackshit', 'headsets', 'headsets',)"/>
					
			<!-- titan ar gunner -->	
			<object filter="'check_swat_ar_titan'" enabled="false" name="'g_body_a'"/>						
			<object filter="'check_swat_ar_titan'" enabled="false" name="'g_body_a_lod1'"/>			
			<object filter="'check_swat_ar_titan'" enabled="true" name="'g_body_gunner'"/>						
			<object filter="'check_swat_ar_titan'" enabled="true" name="'g_body_gunner_lod1'"/>
			<object filter="'check_swat_ar_titan'" enabled="true" name="'g_gear_gunner_a'"/>						
			<object filter="'check_swat_ar_titan'" enabled="true" name="'g_gear_gunner_a_lod1'"/>
			<run_sequence filter="'check_swat_ar_titan'" name="'heavy_helmet_b'"/>
			<run_sequence  filter="'check_swat_ar_titan'" name="'acc_'..pick('headsets','earpiece', 'jackshit', 'headsets', 'headsets',)"/>
					
			<!-- titan sg -->	
			<object filter="'check_swat_sg_titan'" enabled="false" name="'g_body_a'"/>						
			<object filter="'check_swat_sg_titan'" enabled="false" name="'g_body_a_lod1'"/>						
			<object filter="'check_swat_sg_titan'" enabled="true" name="'g_body_gunner'"/>						
			<object filter="'check_swat_sg_titan'" enabled="true" name="'g_body_gunner_lod1'"/>
			<object filter="'check_swat_sg_titan'" enabled="true" name="'g_gear_gunner_b'"/>						
			<object filter="'check_swat_sg_titan'" enabled="true" name="'g_gear_gunner_b_lod1'"/>
			<run_sequence filter="'check_swat_sg_titan'" name="'heavy_helmet_c'"/>
			<run_sequence  filter="'check_swat_sg_titan'" name="'acc_'..pick('headsets','earpiece', 'jackshit', 'headsets', 'headsets',)"/>
			<run_sequence filter="'check_swat_sg_titan'" name="'goggles_'..pick('a', 'a', 'a', 'a', 'a', 'b', 'b')"/>					
		
			<!-- titan tazer -->			
			<object filter="'check_taser'" enabled="true" name="'g_body_tazer'"/>						
			<object filter="'check_taser'" enabled="true" name="'g_body_tazer_lod1'"/>
			<object filter="'check_taser'" enabled="false" name="'g_body_a'"/>						
			<object filter="'check_taser'" enabled="false" name="'g_body_a_lod1'"/>
			<run_sequence filter="'check_taser'" name="'heavy_helmet_d'"/>
			<run_sequence  filter="'check_taser'" name="'acc_'..pick('headsets','earpiece', 'jackshit', 'headsets', 'headsets',)"/>
								
			<!-- sniper -->
			<run_sequence  filter="'check_swat_sniper'" name="'acc_'..pick('earpiece','earpiece', 'jackshit', 'jackshit', 'earpiece')"/>
			<run_sequence  filter="'check_swat_sniper'" name="'acc_'..pick('facemask','facemask', 'jackshit', 'facemask', 'facemask')"/>
			<run_sequence  filter="'check_swat_sniper'" name="'acc_'..pick('scarf','scarf', 'jackshit', 'scarf', 'scarf')"/>
			<object  filter="'check_swat_sniper'"  enabled="true" name="'g_hat_lod1'"/>
			<object  filter="'check_swat_sniper'"  enabled="true" name="'g_hat_lod2'"/>
			<object  filter="'check_swat_sniper'"  enabled="true" name="'g_hat_lod3'"/>
			<run_sequence  filter="'check_swat_sniper'" name="'body_'..pick('shitbag', 'nothing', 'shitbag')"/>			
			<object  filter="'check_swat_sniper'"  enabled="true" name="'g_swat_sniper'"/>
			<object  filter="'check_swat_sniper'"  enabled="true" name="'g_swat_sniper_lod1'"/>
		</sequence>
		
		<sequence editable_state="true" name="'acc_facemask'" once="true" triggable="true">
			<object enabled="true" name="'g_facemask'"/>
			<body enabled="true" name="'sg_mask'"/>
			<decal_mesh enabled="true" name="'c_mask'"/>
			<object enabled="true" name="'g_facemask_lod1'"/>
		</sequence>

		<sequence editable_state="true" name="'spawn_helmet'" once="true" triggable="true">
			<decal_mesh filter="'check_goggle_b'" enabled="false" name="'c_glass'" />										
			<object filter="'check_goggle_b'" 	  enabled="false" name="'g_glass'"/>						
			<object filter="'check_goggle_b'" 	  enabled="false" name="'g_goggles_b'"/>						
			<object filter="'check_goggle_b'" 	  enabled="false" name="'g_goggles_a_lod1'"/>						
			<object filter="'check_goggle_b'" 	  enabled="false" name="'g_glass_crk'"/>						

			<object enabled="false" name="'g_helmet_lod1'"/>						
			<object enabled="false" name="'g_helmet_lod2'"/>						
			<object enabled="false" name="'g_hat_lod1'"/>						
			<object enabled="false" name="'g_hat_lod2'"/>						
			<object enabled="false" name="'g_hat_lod3'"/>						
			<object enabled="false" name="'g_helmet_lod3'"/>						
			<object enabled="false" name="'g_helmet_lod4'"/>						
			<object enabled="false" name="'g_helmet_lod5'"/>						
			<object enabled="false" name="'g_helmet_lod6'"/>						
			<object enabled="false" name="'g_helmet_lod7'"/>						
			<object enabled="false" name="'g_helmet_lod8'"/>						
			<object enabled="false" name="'g_helmet_lod9'"/>						
			<object enabled="false" name="'g_helmet_lod10'"/>						
			<object enabled="false" name="'g_helmet_lod11'"/>						
			<object enabled="false" name="'g_helmet_lod12'"/>						
			<object enabled="false" name="'g_helmet_lod13'"/>						
	
			<decal_mesh enabled="false" name="'c_glass_shield'" />	
			
			<graphic_group  filter="'check_helmet'"  enabled="true" name="'acc_helmet'"/>
			<body 		    filter="'check_helmet'"  enabled="true" name="'acc_helmet'" position="object_pos('Head')" rotation="object_rot('Head')" transfer_ang_velocity="v( 50 * rand(), 50 * rand(), 500 * rand() )" transfer_velocity="v( 0, 200 * rand(), 200 * rand() )"/>			
			<decal_mesh 	filter="'check_helmet'"  enabled="true" name="'c_helmet_acc'" />										

			<body 		    filter="'check_helmet'" enabled="false" name="'acc_helmet'" start_time="30"/>	
			<graphic_group  filter="'check_helmet'"  enabled="false" name="'acc_helmet'" start_time="30"/>
			<decal_mesh	    filter="'check_helmet'"  enabled="false" name="'c_helmet_acc'" start_time="30"/>

			<graphic_group  filter="'check_swat_sniper'"  enabled="true" name="'acc_helmet'"/>
			<body 		    filter="'check_swat_sniper'"  enabled="true" name="'acc_hat'" position="object_pos('Head')" rotation="object_rot('Head')" transfer_ang_velocity="v( 50 * rand(), 50 * rand(), 500 * rand() )" transfer_velocity="v( 0, 200 * rand(), 200 * rand() )"/>			
			<decal_mesh 	filter="'check_swat_sniper'"  enabled="true" name="'c_hat_acc'" />										
			<object  filter="'check_swat_sniper'"  		  enabled="false" name="'g_acc_helmet'"/>
			<object  filter="'check_swat_sniper'"  		  enabled="true" name="'g_hat_acc'"/>

			<body 		    filter="'check_swat_sniper'" enabled="false" name="'acc_hat'" start_time="30"/>	
			<graphic_group  filter="'check_swat_sniper'"  enabled="false" name="'acc_helmet'" start_time="30"/>			
			<object 		    filter="'check_swat_sniper'" enabled="false" name="'g_hat_acc'" start_time="30"/>	
			<decal_mesh	    filter="'check_swat_sniper'"  enabled="false" name="'c_hat_acc'" start_time="30"/>

			
			<body enabled="false" name="'glass_shield'" />										
			<body enabled="false" name="'glass_swat'" />		
			<body enabled="false" name="'glass_visor'" />		
	
			<decal_mesh enabled="false" name="'c_mask'" />			
			<decal_mesh enabled="false" name="'dm_helmet'" />			
			
											
			<body filter="'check_swat_ar'" enabled="false" name="'glass_visor'" />	
			<run_sequence filter="'check_swat_ar'" name="'destroy_visor'"/>						
			<run_sequence filter="'check_swat_sg'" name="'destroy_visor'"/>						
			<run_sequence filter="'check_swat_shield'" name="'destroy_visor'"/>						
			<body filter="'check_swat_sg'" enabled="false" name="'glass_shield'" />										
			<body filter="'check_swat_shield'" enabled="false" name="'glass_shield'" />										
		</sequence>
		
		<!-- shield/titan lmg gunner -->
		<sequence editable_state="true" name="'heavy_helmet_b'" once="true" triggable="true">
			<object enabled="true" name="'g_helmet_lod1'"/>
			<object enabled="true" name="'g_helmet_lod2'"/>
			<object enabled="true" name="'g_helmet_lod3'"/>			
			<object enabled="true" name="'g_helmet_lod4'"/>			
			<object enabled="true" name="'g_helmet_lod5'"/>
			<body  	enabled="true" name="'glass_shield'" />		
			<decal_mesh enabled="true" name="'c_glass_shield'" />				
			<decal_mesh enabled="true" name="'dm_helmet'" />				
		</sequence>
		
		<!--titan sg gunner -->
		<sequence editable_state="true" name="'heavy_helmet_c'" once="true" triggable="true">
			<object enabled="true" name="'g_helmet_lod1'"/>
			<object enabled="true" name="'g_helmet_lod2'"/>
			<object enabled="true" name="'g_helmet_lod9'"/>
			<object enabled="true" name="'g_helmet_lod10'"/>
			<body  	enabled="true" name="'sg_mask'" />		
			<decal_mesh enabled="true" name="'c_mask'" />	
			<decal_mesh enabled="true" name="'dm_helmet'" />							
		</sequence>
		
		<sequence editable_state="true" name="'body_shitbag'" once="true" triggable="true">
			<object enabled="false" name="'g_body_a'"/>
			<object enabled="false" name="'g_body_a_lod1'"/>
			<object enabled="true" name="'g_body_b'"/>
			<object enabled="true" name="'g_body_b_lod1'"/>
		</sequence>
		
		<!-- titan taser -->
		<sequence editable_state="true" name="'heavy_helmet_d'" once="true" triggable="true">
			<object enabled="true" name="'g_helmet_lod1'"/>
			<object enabled="true" name="'g_helmet_lod2'"/>
			<object enabled="true" name="'g_helmet_lod11'"/>
			<object enabled="true" name="'g_helmet_lod12'"/>
			<object enabled="true" name="'g_helmet_lod13'"/>
			<decal_mesh enabled="true" name="'c_mask'" />
			<decal_mesh enabled="true" name="'dm_helmet'" />							
		</sequence>
				

		<sequence editable_state="true" name="'crk_visor'" once="true" triggable="true">			
			<object filter="'check_swat_sg'" enabled="false" name="'g_helmet_sg_lod3'"/>
			<object filter="'check_swat_sg'" enabled="true" name="'g_helmet_sg_lod4'"/>
			<body filter="'check_swat_sg'" enabled="false" name="'glass_shield'"/>
			<effect filter="'check_swat_sg'" damp_time="5" name="'effects/particles/bullet_hit/glass_breakable/bullet_hit_glass_breakable'" parent="object( 'Head' )" position="v()"/>
			
			<body filter="'check_swat_ar'" enabled="false" name="'glass_visor'"/>
			<object filter="'check_swat_ar'" enabled="false" name="'g_helmet_lod3'"/>
			<object filter="'check_swat_ar'" enabled="true" name="'g_helmet_lod4'"/>
		</sequence>				

		<sequence editable_state="true" name="'destroy_visor'" once="true" triggable="true">			
			<object filter="'check_swat_sg_titan'" enabled="false" name="'g_helmet_lod9'"/>
			<object filter="'check_swat_sg_titan'" enabled="false" name="'g_helmet_lod10'"/>
			<body filter="'check_swat_sg_titan'" enabled="false" name="'sg_mask'"/>
			<decal_mesh filter="'check_swat_sg_titan'" enabled="false" name="'c_mask'"/>
			<sound filter="'check_swat_sg_titan'"  action="'play'" event="'swatturret_weakspot_hit'" object="'Head'"/>					
			<sound filter="'check_swat_sg_titan'"  action="'play'" event="'swatturret_weakspot_hit'" object="'Head'"/>								
			<effect filter="'check_swat_sg_titan'" damp_time="4" name="'effects/payday2/particles/impacts/metal_impact_pd2'" parent="object( 'Head' )" position="v()"/>			
			<effect filter="'check_swat_sg_titan'" damp_time="5" name="'effects/payday2/particles/impacts/metal_impact_pd2'" parent="object( 'Head' )" position="v()"/>
	
			<body filter="'check_swat_ar_titan'" enabled="false" name="'glass_visor'"/>
			<object filter="'check_swat_ar_titan'" enabled="false" name="'g_helmet_lod5'"/>
			<object filter="'check_swat_ar_titan'" enabled="false" name="'g_helmet_lod6'"/>
			<effect filter="'check_swat_ar_titan'" damp_time="5" name="'effects/particles/bullet_hit/glass_breakable/bullet_hit_glass_breakable'" parent="object( 'Head' )" position="v()"/>
			<effect filter="'check_swat_ar_titan'" damp_time="5" name="'effects/particles/bullet_hit/glass_breakable/bullet_hit_glass_breakable'" parent="object( 'Head' )" position="v()"/>

			<sound filter="'check_swat_ar_titan'" action="'play'" event="'swat_heavy_visor_shatter'" object="'Head'"/>			
			<sound filter="'check_swat_ar_titan'" action="'play'" event="'swat_heavy_visor_shatter'" object="'Head'"/>
			
			<body filter="'check_swat_shield'" enabled="false" name="'glass_visor'"/>
			<object filter="'check_swat_shield'" enabled="false" name="'g_helmet_lod5'"/>
			<object filter="'check_swat_shield'" enabled="false" name="'g_helmet_lod6'"/>
			<effect filter="'check_swat_shield'" damp_time="5" name="'effects/particles/bullet_hit/glass_breakable/bullet_hit_glass_breakable'" parent="object( 'Head' )" position="v()"/>
			<effect filter="'check_swat_shield'" damp_time="5" name="'effects/particles/bullet_hit/glass_breakable/bullet_hit_glass_breakable'" parent="object( 'Head' )" position="v()"/>

			<sound filter="'check_swat_shield'" action="'play'" event="'swat_heavy_visor_shatter'" object="'Head'"/>			
			<sound filter="'check_swat_shield'" action="'play'" event="'swat_heavy_visor_shatter'" object="'Head'"/>			
			
		</sequence>				
		
		<sequence editable_state="true" name="'goggles_a'" once="true" triggable="true">
			<object enabled="true" name="'g_goggles_a'"/>
			<object enabled="true" name="'g_goggles_a_lod1'"/>
			<object enabled="true" name="'g_glass'"/>
			<set_variables var_goggles="1"/>					
			<decal_mesh enabled="true" name="'c_glass'" />					
			<body enabled="true" name="'glass_swat'" />										
		</sequence>
		
		<sequence editable_state="true" name="'goggles_b'" once="true" triggable="true">
			<object enabled="true" name="'g_helmet_lod3'"/>
			<object enabled="true" name="'g_helmet_lod4'"/>
			<object enabled="true" name="'g_glass'"/>
			
			<set_variables var_goggles="2"/>										
			<decal_mesh enabled="true" name="'c_glass'" />					
			<body enabled="true" name="'glass_swat'" />										
		</sequence>

		<sequence editable_state="true" name="'goggles_c'" once="true" triggable="true">
			<object enabled="true" name="'g_glasses'"/>
			<object enabled="true" name="'g_glasses_glass'"/>
			<set_variables var_goggles="3"/>										
		</sequence>

		<sequence editable_state="true" name="'goggles_d'" once="true" triggable="true">
			<object enabled="true" name="'g_shades'"/>
			<object enabled="true" name="'g_shades_lod1'"/>
			<object enabled="true" name="'g_glass_shades'"/>
			<set_variables var_goggles="3"/>										
		</sequence>

		<sequence editable_state="true" name="'acc_headsets'" once="true" triggable="true">
			<object enabled="true" name="'g_helmet_lod7'"/>
			<object enabled="true" name="'g_helmet_lod8'"/>
		</sequence>

		<sequence editable_state="true" name="'acc_gloves'" once="true" triggable="true">
			<object enabled="true" name="'g_gloves'"/>
			<object enabled="true" name="'g_gloves_lod1'"/>
		</sequence>

		<sequence editable_state="true" name="'acc_scarf'" once="true" triggable="true">
			<object enabled="true" name="'g_scarf'"/>
			<object enabled="true" name="'g_scarf_lod1'"/>
		</sequence>

		<sequence editable_state="true" name="'acc_earpiece'" once="true" triggable="true">
			<object enabled="true" name="'g_earpiece'"/>
