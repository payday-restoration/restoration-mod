<table>
	<unit>
		<body name="'body_helmet_plate'">
			<endurance damage="15" explosion="85">
				<run_sequence name="'int_seq_helmet_plate'"/>
			</endurance>
		</body>
		<body name="'body_armor_left_shoulderpad'">
			<endurance damage="15" explosion="85">
				<run_sequence name="'int_seq_spawn_shoulderpad_left'"/>
			</endurance>
		</body>
		<body name="'body_armor_right_shoulderpad'">
			<endurance damage="15" explosion="85">
				<run_sequence name="'int_seq_spawn_shoulderpad_right'"/>
			</endurance>
		</body>
		<body name="'body_armor_right_thigh'">
			<endurance damage="15" explosion="85">
				<run_sequence name="'int_seq_spawn_thigh_right'"/>
			</endurance>
		</body>
		<body name="'body_armor_left_thigh'">
			<endurance damage="15" explosion="85">
				<run_sequence name="'int_seq_spawn_thigh_left'"/>
			</endurance>
		</body>
		<body name="'body_helmet_plate_black'">
			<endurance damage="15" explosion="85">
				<run_sequence name="'int_seq_helmet_plate_black'"/>
			</endurance>
		</body>
		<body name="'body_helmet_glass'">
			<endurance damage="8" explosion="75">
				<run_sequence name="'int_seq_helmet_glass_01'"/>
			</endurance>
			<endurance damage="16" explosion="75">
				<run_sequence name="'int_seq_helmet_glass_02'"/>
			</endurance>
		</body>
		<body name="'body_helmet_glass_black'">
			<endurance damage="8" explosion="75">
				<run_sequence name="'int_seq_helmet_glass_01_black'"/>
			</endurance>
			<endurance damage="16" explosion="75">
				<run_sequence name="'int_seq_helmet_glass_02_black'"/>
			</endurance>
		</body>
		<body name="'head'">
			<endurance explosion="35">
				<run_sequence name="'int_seq_helmet_pop'"/>
			</endurance>
		</body>
		<body name="'body_armor_back'">
			<endurance damage="95" explosion="85">
				<run_sequence name="'int_seq_armor_back'"/>
			</endurance>
		</body>
		<body name="'body_armor_chest'">
			<endurance damage="95" explosion="75">
				<run_sequence name="'int_seq_armor_chest'"/>
			</endurance>
		</body>
		<body name="'body_armor_stomache'">
			<endurance damage="75" explosion="50">
				<run_sequence name="'int_seq_armor_stomache'"/>
			</endurance>
		</body>		
		<body name="'body_armor_throat'">
			<endurance damage="8" explosion="50">
				<run_sequence name="'int_seq_armor_throat'"/>
			</endurance>
		</body>
		<body name="'body_armor_neck'">
			<endurance damage="8" explosion="50">
				<run_sequence name="'int_seq_armor_neck'"/>
			</endurance>
		</body>			
		<variables>
			<var_dozer_var value="0"/>							
			<var_helmet		  value="'units/payday2/characters/ene_bulldozer_1_sc/debris/ene_acc_bulldozer_helmet/ene_acc_bulldozer_helmet'"/>			
			<var_helmet_black value="'units/payday2/characters/ene_acc_swat_helmet/ene_acc_swat_helmet'"/>			
			<var_helmet_skull value="'units/payday2/characters/ene_bulldozer_3_sc/debris/ene_acc_bulldozer_helmet/ene_acc_bulldozer_helmet'"/>			
			<var_helmet_plate value="'units/pd2_mod_nypd/characters/ene_bulldozer_1/debris/ene_acc_bulldozer_helmet_plate/ene_acc_bulldozer_helmet_plate'"/>
			<var_helmet_plate_black value="'units/payday2/characters/ene_bulldozer_2_sc/debris/ene_acc_bulldozer_helmet_plate/ene_acc_bulldozer_helmet_plate'"/>
			<var_neck 		  value="'units/pd2_mod_nypd/characters/ene_bulldozer_1/debris/ene_acc_bulldozer_neck/ene_acc_bulldozer_neck'"/>
			<var_shoulderpad_l value="'units/pd2_mod_nypd/characters/ene_bulldozer_1/debris/ene_acc_shoulderpad_l/ene_acc_shoulderpad_l'"/>
			<var_thigh_l 	   value="'units/pd2_mod_nypd/characters/ene_bulldozer_1/debris/ene_acc_thigh_l/ene_acc_thigh_l'"/>
			<var_neck_black   value="'units/payday2/characters/ene_acc_bulldozer_neck_2/ene_acc_bulldozer_neck_2'"/>
			<var_throat 	  value="'units/pd2_mod_nypd/characters/ene_bulldozer_1/debris/ene_acc_bulldozer_throat/ene_acc_bulldozer_throat'"/>
			<var_throat_black value="'units/payday2/characters/ene_acc_bulldozer_throat_2/ene_acc_bulldozer_throat_2'"/>
			<var_chest 		  value="'units/payday2/characters/ene_acc_bulldozer_chest/ene_acc_bulldozer_chest'"/>
			<var_stomache 	  value="'units/payday2/characters/ene_acc_bulldozer_stomache/ene_acc_bulldozer_stomache'"/>
			<var_back 		  value="'units/payday2/characters/ene_acc_bulldozer_back/ene_acc_bulldozer_back'"/>
		</variables>
		<filter name="'check_normal'">
			<check value="vars.var_dozer_var == 0"/>
		</filter>
		
		<filter name="'check_black'">
			<check value="vars.var_dozer_var == 1"/>
		</filter>
		<filter name="'check_skull'">
			<check value="vars.var_dozer_var == 2"/>
		</filter>
		<filter name="'check_la'">
			<check value="vars.var_dozer_var == 3"/>
		</filter>
		
		<filter name="'check_normal_non_la'">
			<check value="vars.var_dozer_var <= 2"/>		
		</filter>

		<sequence editable_state="true" name="'black'" triggable="true" once="true">		
			<set_variables var_dozer_var="1"/>
			<body enabled="false" name="'body_helmet_plate'"/>
			<decal_mesh enabled="false" name="'dm_helmet_plate'"/>			
			<body enabled="false" name="'body_helmet'"/>
			<body enabled="false" name="'body_armor_throat'"/>
			<body enabled="false" name="'body_armor_neck'"/>
			<decal_mesh enabled="false" name="'dm_helmet'"/>	

			<object enabled="false" name="'g_armor_chest'"/>
			<object enabled="false" name="'g_armor_chest_lod1'"/>
			<object enabled="false" name="'g_armor_back'"/>
			<object enabled="false" name="'g_armor_back_lod1'"/>
			<object enabled="false" name="'g_neck'"/>
			<object enabled="false" name="'g_neck_lod1'"/>
			<object enabled="false" name="'g_throat'"/>
			<object enabled="false" name="'g_throat_lod1'"/>
			<object enabled="false" name="'g_helmet_plate'"/>
			<object enabled="false" name="'g_helmet_plate_lod1'"/>
			<object enabled="false" name="'g_helmet'"/>
			<object enabled="false" name="'g_helmet_glass'"/>
			<object enabled="false" name="'g_helmet_glass_lod1'"/>
			<object enabled="false" name="'g_helmet_lod1'"/>
			<object enabled="false" name="'g_armor_stomache'"/>
			<object enabled="false" name="'g_armor_stomache_lod1'"/>
			<object enabled="false" name="'g_body_lod1'"/>	
			<object enabled="false" name="'g_body'"/>	
			<object enabled="false" name="'g_swat_sg'"/>
			<object enabled="false" name="'g_swat_sg_lod1'"/>	
			
			<object enabled="true" name="'g_armor_back_black'"/>
			<object enabled="true" name="'g_armor_back_black_lod1'"/>

			<object enabled="true" name="'g_body_black'"/>
			<object enabled="true" name="'g_body_black_lod1'"/>	
			
			<object enabled="false" name="'g_thigh_r'"/>
			<object enabled="false" name="'g_thigh_r_lod1'"/>	
			<object enabled="false" name="'g_thigh_l'"/>
			<object enabled="false" name="'g_thigh_l_lod1'"/>	
			<object enabled="false" name="'g_shoulderpad_r'"/>
			<object enabled="false" name="'g_shoulderpad_r_lod1'"/>	
			<object enabled="false" name="'g_shoulderpad_l'"/>
			<object enabled="false" name="'g_shoulderpad_l_lod1'"/>	

			<object enabled="true" name="'g_thigh_r_black'"/>
			<object enabled="true" name="'g_thigh_r_black_lod1'"/>	
			<object enabled="true" name="'g_thigh_l_black'"/>
			<object enabled="true" name="'g_thigh_l_black_lod1'"/>	
			<object enabled="true" name="'g_shoulderpad_r_black'"/>
			<object enabled="true" name="'g_shoulderpad_r_black_lod1'"/>	
			<object enabled="true" name="'g_shoulderpad_l_black'"/>
			<object enabled="true" name="'g_shoulderpad_l_black_lod1'"/>	
			
			<object enabled="true" name="'g_dozer_black'"/>
			<object enabled="true" name="'g_dozer_black_lod1'"/>	
			
			<object enabled="true" name="'g_helmet_lod2'"/>
			<object enabled="true" name="'g_helmet_lod3'"/>	
			<object enabled="true" name="'g_helmet_lod4'"/>	
			<object enabled="true" name="'g_helmet_plate_lod2'"/>	
			
			<object enabled="true" name="'g_neck_black'"/>
			<object enabled="true" name="'g_neck_black_lod1'"/>
			<object enabled="true" name="'g_throat_black'"/>			
			<object enabled="true" name="'g_throat_black_lod1'"/>			
			<object enabled="true" name="'g_armor_chest_black'"/>
			<object enabled="true" name="'g_armor_chest_black_lod1'"/>
			<object enabled="true" name="'g_armor_stomache_black'"/>
			<object enabled="true" name="'g_armor_stomache_black_lod1'"/>
			
			<body enabled="true" name="'body_helmet_black'"/>
			<body enabled="true" name="'body_helmet_glass_black'"/>
			<body enabled="true" name="'body_helmet_plate_black'"/>
			
			<decal_mesh enabled="true" name="'dm_helmet_black'"/>
			<decal_mesh enabled="true" name="'dm_helmet_black_glass'"/>
			<decal_mesh enabled="true" name="'dm_helmet_plate_black'"/>
			
			<body enabled="true" name="'body_armor_throat_black'"/>
			<body enabled="true" name="'body_armor_neck_black'"/>
		</sequence>

		<sequence editable_state="true" name="'skull'" triggable="true" once="true">						
			<set_variables var_dozer_var="2"/>
			
			<body enabled="false" name="'body_armor_left_thigh'"/>
			<decal_mesh enabled="false" name="'c_armor_LeftUpLeg'"/>	
			<body enabled="false" name="'body_armor_right_thigh'"/>
			<decal_mesh enabled="false" name="'c_armor_RightUpLeg'"/>	
			
			<object enabled="false" name="'g_armor_chest'"/>	
			<object enabled="false" name="'g_armor_chest_lod1'"/>	
			<object enabled="false" name="'g_armor_stomache'"/>			
			<object enabled="false" name="'g_armor_stomache_lod1'"/>			
			<object enabled="false" name="'g_armor_back'"/>			
			<object enabled="false" name="'g_armor_back_lod1'"/>			
			<object enabled="false" name="'g_helmet_glass'"/>
			<object enabled="false" name="'g_helmet_glass_lod1'"/>	
			
			<object enabled="true" name="'g_armor_chest_skull'"/>
			<object enabled="true" name="'g_armor_chest_skull_lod1'"/>
			
			<object enabled="true" name="'g_armor_back_skull'"/>
			<object enabled="true" name="'g_armor_back_skull_lod1'"/>
						
			<object enabled="true" name="'g_dozer_skull'"/>
			<object enabled="true" name="'g_dozer_skull_lod1'"/>
			
			<object enabled="false" name="'g_balaclava_a'"/>
			<object enabled="false" name="'g_balaclava_a_lod1'"/>
			
			<object enabled="false" name="'g_balaclava_b'"/>
			<object enabled="false" name="'g_balaclava_b_lod1'"/>
			
			<object enabled="true" name="'g_balaclava_c'"/>
			<object enabled="true" name="'g_balaclava_c_lod1'"/>
			
			<object enabled="false" name="'g_body'"/>
			<object enabled="false" name="'g_body_lod1'"/>	
						
			<object enabled="false" name="'g_thigh_r'"/>
			<object enabled="false" name="'g_thigh_r_lod1'"/>	
			<object enabled="false" name="'g_swat_sg'"/>
			<object enabled="false" name="'g_swat_sg_lod1'"/>	
			<object enabled="false" name="'g_thigh_l'"/>
			<object enabled="false" name="'g_thigh_l_lod1'"/>	
			<object enabled="false" name="'g_shoulderpad_r'"/>
			<object enabled="false" name="'g_shoulderpad_r_lod1'"/>	
			<object enabled="false" name="'g_shoulderpad_l'"/>
			<object enabled="false" name="'g_shoulderpad_l_lod1'"/>	
			
			<object enabled="true" name="'g_shoulderpad_r_skull'"/>
			<object enabled="true" name="'g_shoulderpad_r_skull_lod1'"/>	
			<object enabled="true" name="'g_shoulderpad_l_skull'"/>
			<object enabled="true" name="'g_shoulderpad_l_skull_lod1'"/>	
						
			<object enabled="true" name="'g_body_skull'"/>
			<object enabled="true" name="'g_body_skull_lod1'"/>	
						
			<object enabled="true" name="'g_helmet_glass_red'"/>
			<object enabled="true" name="'g_helmet_glass_red_lod1'"/>	
			
			<object enabled="true" name="'g_armor_stomache_skull'"/>
			<object enabled="true" name="'g_armor_stomache_skull_lod1'"/>
		</sequence>
		
		<sequence name="'select_face'" startup="true" once="true">
			<run_sequence name="'head'..pick('_balaclava_a', '_balaclava_a', '_balaclava_b', '_balaclava_a', '_balaclava_b', '_balaclava_a', '_balaclava_a', '_balaclava_a', '_balaclava_a')"/>
			<run_sequence name="'face'..pick('_a','_a','_c','_d','_e', '_b', '_g', '_f', '_h')" />
		</sequence>		

		<sequence editable_state="true" name="'head_balaclava_a'" triggable="true" once="true">	
			<object enabled="true" name="'g_balaclava_a'"/>
			<object enabled="true" name="'g_balaclava_a_lod1'"/>	
		</sequence>							

		<sequence editable_state="true" name="'head_balaclava_b'" triggable="true" once="true">	
			<object enabled="true" name="'g_balaclava_b'"/>
			<object enabled="true" name="'g_balaclava_b_lod1'"/>	
		</sequence>							

		<sequence editable_state="true" name="'face_a'" once="true" triggable="true">
			<object enabled="true" name="'g_face_a'"/>
			<object enabled="true" name="'g_face_a_lod1'"/>
		</sequence>								
		<sequence editable_state="true" name="'face_b'" once="true" triggable="true">
			<object enabled="true" name="'g_face_b'"/>
			<object enabled="true" name="'g_face_b_lod1'"/>
		</sequence>								
		<sequence editable_state="true" name="'face_c'" once="true" triggable="true">
			<object enabled="true" name="'g_face_c'"/>
			<object enabled="true" name="'g_face_c_lod1'"/>
		</sequence>								
		<sequence editable_state="true" name="'face_d'" once="true" triggable="true">
			<object enabled="true" name="'g_face_d'"/>
			<object enabled="true" name="'g_face_d_lod1'"/>
		</sequence>								
		<sequence editable_state="true" name="'face_e'" once="true" triggable="true">
			<object enabled="true" name="'g_face_e'"/>
			<object enabled="true" name="'g_face_e_lod1'"/>
		</sequence>	
		<sequence editable_state="true" name="'face_f'" once="true" triggable="true">
			<object enabled="true" name="'g_face_f'"/>
			<object enabled="true" name="'g_face_f_lod1'"/>
		</sequence>	
		<sequence editable_state="true" name="'face_g'" once="true" triggable="true">
			<object enabled="true" name="'g_face_g'"/>
			<object enabled="true" name="'g_face_g_lod1'"/>
		</sequence>	
		<sequence editable_state="true" name="'face_h'" once="true" triggable="true">
			<object enabled="true" name="'g_face_h'"/>
			<object enabled="true" name="'g_face_h_lod1'"/>
		</sequence>	
		
		<sequence name="'int_seq_helmet_plate'" once="true">
			<body enabled="false" name="'body_helmet_plate'"/>
			<object enabled="false" name="'g_helmet_plate'"/>
			<object enabled="false" name="'g_helmet_plate_lod1'"/>
			<decal_mesh enabled="false" name="'dm_helmet_plate'"/>
			<body enabled="true" name="'body_helmet_glass'"/>
			<decal_mesh enabled="true" name="'dm_helmet_glass'"/>
			<spawn_unit name="vars.var_helmet_plate" position="object_pos('Head')" rotation="object_rot('Head')"/>
			<sound action="'play'" event="'bulldozer_metal_plate_shatter'" object="'Head'"/>
		</sequence>
		
		<sequence name="'int_seq_helmet_plate_black'" once="true">
			<decal_mesh enabled="false" name="'dm_helmet_plate_black'"/>
			<object enabled="false" name="'g_helmet_plate_lod2'"/>
			<body enabled="false" name="'body_helmet_plate_black'"/>
			
			<body enabled="true" name="'body_helmet_glass_black'"/>
			<object enabled="true" name="'g_helmet_lod4'"/>
			<object enabled="true" name="'g_helmet_glass_black_contour'"/>
			<decal_mesh enabled="true" name="'dm_helmet_glass'"/>
			<spawn_unit name="vars.var_helmet_plate_black" position="object_pos('Head')" rotation="object_rot('Head')" transfer_ang_velocity="v( 50 * rand(), 50 * rand(), 500 * rand() )" transfer_velocity="v( 0, 450 * rand(), 650 * rand() )"/>			
			<sound action="'play'" event="'bulldozer_metal_plate_shatter'" object="'Head'"/>
		</sequence>
		
		<sequence name="'int_seq_helmet_glass_01_black'" once="true">
			<object enabled="false" name="'g_helmet_lod4'"/>
			<object enabled="true" name="'g_helmet_lod5'"/>
		</sequence>
		<sequence name="'int_seq_helmet_glass_02_black'" once="true">
			<sound action="'play'" event="'bulldozer_visor_shatter'" object="'Head'"/>
			<body enabled="true" name="'head'"/>
			<body enabled="false" name="'body_helmet_black'"/>
			<body enabled="false" name="'body_helmet_glass_black'"/>
			<object enabled="false" name="'g_helmet_glass'"/>
			<object enabled="false" name="'g_helmet_lod4'"/>
			<object enabled="false" name="'g_helmet_lod5'"/>
			<object enabled="false" name="'g_helmet_glass_black_contour'"/>
			<object enabled="false" name="'g_helmet_glass_lod1'"/>
			<object enabled="false" name="'g_helmet_glass_crk'"/>
			<object enabled="false" name="'g_helmet_glass_crk_lod1'"/>
			<decal_mesh enabled="false" name="'dm_helmet_glass'"/>
			<decal_mesh enabled="true" name="'dm_head'"/>
			<effect damp_time="4" name="'effects/particles/bullet_hit/glass_breakable/bullet_hit_glass_breakable'" parent="object( 'e_glass' )" position="v()"/>
			<effect damp_time="5" name="'effects/particles/bullet_hit/glass_breakable/bullet_hit_glass_breakable'" parent="object( 'e_glass' )" position="v()"/>
			<function extension="'character_damage'" function="'seq_clbk_vizor_shatter'" start_time="1"/>
		</sequence>
		
		<sequence name="'int_seq_helmet_glass_01'" once="true">
			<object enabled="false" name="'g_helmet_glass'"/>
			<object enabled="false" name="'g_helmet_glass_lod1'"/>
			<object enabled="false" name="'g_helmet_glass_red'"/>
			<object enabled="false" name="'g_helmet_glass_red_lod1'"/>
			<object filter="'check_normal'" enabled="true" name="'g_helmet_glass_crk'"/>
			<object filter="'check_normal'" enabled="true" name="'g_helmet_glass_crk_lod1'"/>
			<object filter="'check_skull'" enabled="true" name="'g_helmet_glass_red_crk'"/>
			<object filter="'check_skull'" enabled="true" name="'g_helmet_glass_red_crk_lod1'"/>
		</sequence>
		<sequence name="'int_seq_helmet_glass_02'" once="true">
			<sound action="'play'" event="'bulldozer_visor_shatter'" object="'Head'"/>
			<body enabled="true" name="'head'"/>
			<body enabled="false" name="'body_helmet_glass'"/>
			<body enabled="false" name="'body_helmet'"/>
			<object enabled="false" name="'g_helmet_glass'"/>
			<object enabled="false" name="'g_helmet_glass_contour'"/>
			<object enabled="false" name="'g_helmet_glass_lod1'"/>
			<object enabled="false" name="'g_helmet_glass_crk'"/>
			<object enabled="false" name="'g_helmet_glass_crk_lod1'"/>
			<object enabled="false" name="'g_helmet_glass_red_crk'"/>
			<object enabled="false" name="'g_helmet_glass_red_crk_lod1'"/>
			<decal_mesh enabled="false" name="'dm_helmet_glass'"/>
			<decal_mesh enabled="true" name="'dm_head'"/>
			<effect damp_time="4" name="'effects/particles/bullet_hit/glass_breakable/bullet_hit_glass_breakable'" parent="object( 'e_glass' )" position="v()"/>
			<effect damp_time="5" name="'effects/particles/bullet_hit/glass_breakable/bullet_hit_glass_breakable'" parent="object( 'e_glass' )" position="v()"/>
			<function extension="'character_damage'" function="'seq_clbk_vizor_shatter'" start_time="1"/>
		</sequence>
		<sequence name="'int_seq_helmet_pop'" once="true">
			<sound filter="'check_black'" action="'play'" event="'bulldozer_metal_plate_shatter'" object="'Head'"/>		
			<sound filter="'check_black'" action="'play'" event="'knife_equip'" object="'Head'"/>
			<sound filter="'check_black'" action="'play'" event="'knife_hit_gen'" object="'Head'"/>
			<sound filter="'check_black'" action="'play'" event="'knuckles_hit_gen'" object="'Head'"/>
			<sound filter="'check_black'" action="'play'" event="'knuckles_hit_gen'" object="'Head'"/>
			<decal_mesh enabled="false" name="'dm_helmet_black'"/>			
			<decal_mesh enabled="false" name="'c_helmet_black_1'"/>			
			<decal_mesh enabled="false" name="'c_helmet_black_2'"/>			
			<spawn_unit filter="'check_black'" name="vars.var_helmet_black" position="object_pos('Head')" rotation="object_rot('Head')" transfer_ang_velocity="v( 50 * rand(), 50 * rand(), 500 * rand() )" transfer_velocity="v( 0, 450 * rand(), 650 * rand() )"/>
		</sequence>
		<sequence name="'int_seq_armor_chest'" once="true">
			<body enabled="false" name="'body_armor_chest'"/>
			<object enabled="false" name="'g_armor_chest'"/>
			<object enabled="false" name="'g_armor_chest_lod1'"/>
			<object enabled="false" name="'g_armor_chest_skull'"/>
			<object enabled="false" name="'g_armor_chest_black'"/>
			<decal_mesh enabled="false" name="'dm_armor_chest'"/>
			<spawn_unit name="vars.var_chest" position="object_pos('Spine1')" rotation="object_rot('Spine1')"/>
			<sound action="'play'" event="'bulldozer_metal_plate_shatter'" object="'Spine1'"/>
		</sequence>
		<sequence name="'int_seq_armor_back'" once="true">
			<body enabled="false" name="'body_armor_back'"/>
			<object enabled="false" name="'g_armor_back'"/>
			<object enabled="false" name="'g_armor_back_lod1'"/>
