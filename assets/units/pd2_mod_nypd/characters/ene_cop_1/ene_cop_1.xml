			<run_sequence filter="'check_fbi_3'" name="'body_fbi3'..pick('_shortsleeve','_shortsleeve','_shortsleeve', '_shortsleeve', '_shortsleeve', '_longsleeve', '_shortsleeve', '_shortsleeve')"/>			
			
			<!-- fbi vetcop -->
			<run_sequence filter="'check_fbi_vet'" name="'head_'..pick('a','b','b', 'a', 'a', 'c', 'd', 'c')"/>			
			
			<!-- fbi vetcop blood -->
