<dynamic_object>
	<diesel orientation_object="rp_ene_acc_shield_small" materials="units/pd2_mod_reapers/characters/ene_acc_shield_lights/ene_acc_shield_lights"/>
	<sequence_manager file="units/pd2_mod_reapers/characters/ene_acc_shield_lights/ene_acc_shield_lights"/>
	<bodies>
		<body name="held_body" enabled="true" template="animated" collision_class="ragdoll" pushed_by_mover="false" remove_ray_type="ai_vision walk">
			<object name="rp_ene_acc_shield_small"/>
			<object name="c_box_middle" collision_type="box" padding="-2"/>
			<object name="c_sphere_bottom" collision_type="sphere" padding="-2"/>
		</body>

		<body name="shield_visor" enabled="true" template="animated" collision_class="ragdoll" pushed_by_mover="false" remove_ray_type="ai_vision walk">
			<object name="rp_ene_acc_shield_small" />
			<object name="c_box_up1" collision_type="box"/>
			<object name="c_box_up2" collision_type="box"/>
			<object name="c_box_up3" collision_type="box"/>
			<object name="c_box_up4" collision_type="box"/>
			<object name="c_box_up5" collision_type="box"/>
		</body>
		
		<body name="shield_visor2" enabled="true" template="animated" collision_class="ragdoll" pushed_by_mover="false" remove_ray_type="ai_vision walk">
			<object name="rp_ene_acc_shield_small" />
			<object name="c_box_bottom1" collision_type="box"/>
			<object name="c_box_bottom2" collision_type="box"/>
			<object name="c_box_bottom3" collision_type="box"/>
		</body>

		<body name="dropped_body" enabled="false" template="debris" collision_class="ragdoll" pushed_by_mover="false" remove_ray_type="ai_vision walk">
			<object name="rp_ene_acc_shield_small"/>
			<object name="c_box_right" collision_type="box" padding="-2"/>
			<object name="c_box_left_bottom" collision_type="box" padding="-2"/>
			<object name="c_sphere_bottom" collision_type="sphere" padding="-2"/>
		</body>
	</bodies>

	<decal_surfaces>
		<decal_mesh name="dm_glass_up" enabled="true" material="glass_unbreakable"/>
		<decal_mesh name="dm_glass_down" enabled="true" material="glass_unbreakable"/>
		<decal_mesh name="dm_metal" enabled="true" material="shield"/>
	</decal_surfaces>

	<graphics>
		<lod_object name="lod_shield_small">
			<object name="g_shield" enabled="true">
				<material materials="mtr_glass mtr_metal" max_distance="1000"/>
				<material materials="mtr_glass_lod_1 mtr_metal_lod_1" max_distance="1500"/>
				<material materials="mtr_glass_lod_2 mtr_metal_lod_2"/>
			</object>
		</lod_object>
			<object name="g_glass_up" enabled="true">
			</object>
			<object name="g_glass_up_cracked" enabled="false">
			</object>
			<object name="g_glass_down" enabled="true">
			</object>
			<object name="g_glass_down_cracked" enabled="false">
			</object>
		    <object name="g_handles" enabled="true">
			</object>
	</graphics>
</dynamic_object>