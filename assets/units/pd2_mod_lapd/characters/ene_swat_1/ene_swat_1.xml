			<object filter="'check_blue_fbi_shield'" enabled="true" name="'g_swat_shield_lod1'"/>
			<run_sequence filter="'check_blue_fbi_shield'" name="'heavy_helmet_e'"/>
			<run_sequence filter="'check_blue_fbi_shield'" name="'body_'..pick('nothing', 'nothing', 'shitbag')"/>
			<run_sequence filter="'check_blue_fbi_shield'" name="'holster_'..pick('l','r', 'twinnem)"/>
			<run_sequence filter="'check_blue_fbi_shield'" name="'acc_'..pick('nothing','headset','nothing')"/>								
			<run_sequence filter="'check_blue_fbi_shield'" name="'body_'..pick('longsleeve', 'longsleeve', 'nothing')"/>

			<!-- heavy rifleman -->			
			<object filter="'check_fbi_heavy_ar'" enabled="true" name="'g_swat_heavy_ar'"/>						
			<object filter="'check_fbi_heavy_ar'" enabled="true" name="'g_swat_heavy_ar_lod1'"/>
			<object filter="'check_fbi_heavy_ar'" enabled="true" name="'g_body_heavy'"/>						
			<object filter="'check_fbi_heavy_ar'" enabled="true" name="'g_body_heavy_lod1'"/>			
			<object filter="'check_fbi_heavy_ar'" enabled="false" name="'g_body'"/>						
			<object filter="'check_fbi_heavy_ar'" enabled="false" name="'g_body_lod1'"/>			
			<run_sequence filter="'check_fbi_heavy_ar'" name="'heavy_helmet_e'"/>
			<run_sequence filter="'check_fbi_heavy_ar'" name="'body_'..pick('nothing', 'nothing', 'shitbag')"/>
			<run_sequence filter="'check_fbi_heavy_ar'" name="'holster_'..pick('l','r', 'twinnem)"/>
			<run_sequence filter="'check_fbi_heavy_ar'" name="'acc_'..pick('nothing','headset','nothing')"/>								
			
			<object filter="'check_fbi_heavy_sg'" enabled="true" name="'g_swat_heavy_sg'"/>						
			<object filter="'check_fbi_heavy_sg'" enabled="true" name="'g_swat_heavy_sg_lod1'"/>
			<object filter="'check_fbi_heavy_sg'" enabled="true" name="'g_body_heavy'"/>						
			<object filter="'check_fbi_heavy_sg'" enabled="true" name="'g_body_heavy_lod1'"/>			
			<object filter="'check_fbi_heavy_sg'" enabled="false" name="'g_body'"/>						
			<object filter="'check_fbi_heavy_sg'" enabled="false" name="'g_body_lod1'"/>			
			<run_sequence filter="'check_fbi_heavy_sg'" name="'heavy_helmet_f'"/>
			<run_sequence filter="'check_fbi_heavy_sg'" name="'acc_'..pick('nothing','headset','nothing')"/>								
			<run_sequence filter="'check_fbi_heavy_sg'" name="'acc_'..pick('flashlight','nothing','nothing')"/>								

			<!-- gren -->			
			<object filter="'check_blue_gren'" enabled="false" name="'g_helmet_lod1'"/>						
			<object filter="'check_blue_gren'" enabled="false" name="'g_helmet_lod2'"/>
			<object filter="'check_blue_gren'" enabled="false" name="'g_body'"/>						
			<object filter="'check_blue_gren'" enabled="false" name="'g_body_lod1'"/>
			<object filter="'check_blue_gren'" enabled="true" name="'g_body_gren'"/>						
			<object filter="'check_blue_gren'" enabled="true" name="'g_body_gren_lod1'"/>
			<object filter="'check_blue_gren'" enabled="true" name="'g_grenadier'"/>						
			<object filter="'check_blue_gren'" enabled="true" name="'g_grenadier_lod1'"/>
			<object filter="'check_blue_gren'" enabled="true" name="'g_explosivebag'"/>						
			<object filter="'check_blue_gren'" enabled="true" name="'g_explosivebag_lod1'"/>
			
			<object filter="'check_blue_gren'" enabled="true" name="'g_grenadier_mask'"/>						
			<object filter="'check_blue_gren'" enabled="true" name="'g_grenadier_glass'"/>						
			<object filter="'check_blue_gren'" enabled="true" name="'g_grenadier_mask_lod1'"/>
			
			<decal_mesh filter="'check_blue_gren'" enabled="true" name="'c_glass_shield'"/>					
			<body filter="'check_blue_gren'" enabled="true" name="'c_glass_shield'"/>					

