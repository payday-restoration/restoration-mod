<table>
	<unit>
		<body name="'body_helmet_plate'">
			<endurance damage="15" explosion="85">
				<run_sequence name="'int_seq_helmet_plate'"/>
			</endurance>
		</body>
		<body name="'body_helmet_plate_black'">
			<endurance damage="15" explosion="85">
				<run_sequence name="'int_seq_helmet_plate'"/>
			</endurance>
		</body>		
		<body name="'body_helmet_glass'">
			<endurance damage="8" explosion="75">
				<run_sequence name="'int_seq_helmet_glass_01'"/>
			</endurance>
			<endurance damage="16" explosion="75">
				<run_sequence name="'int_seq_helmet_glass_02'"/>
			</endurance>
		</body>
		<body name="'body_helmet_glass_ben'">
			<endurance damage="8" explosion="75">
				<run_sequence name="'int_seq_helmet_glass_01'"/>
			</endurance>
			<endurance damage="16" explosion="75">
				<run_sequence name="'int_seq_helmet_glass_02'"/>
			</endurance>
		</body>
		<body name="'body_helmet_glass_black'">
			<endurance damage="8" explosion="75">
				<run_sequence name="'int_seq_helmet_glass_01'"/>
			</endurance>
			<endurance damage="16" explosion="75">
				<run_sequence name="'int_seq_helmet_glass_02'"/>
			</endurance>
		</body>
		<body name="'head'">
			<endurance explosion="35">
				<run_sequence name="'int_seq_helmet_pop'"/>
			</endurance>
		</body>
		<body name="'body_armor_back'">
			<endurance damage="95" explosion="85">
				<run_sequence name="'int_seq_armor_back'"/>
			</endurance>
		</body>
		<body name="'body_armor_chest'">
			<endurance damage="95" explosion="75">
				<run_sequence name="'int_seq_armor_chest'"/>
			</endurance>
		</body>
		<body name="'body_armor_stomache'">
			<endurance damage="75" explosion="50">
				<run_sequence name="'int_seq_armor_stomache'"/>
			</endurance>
		</body>		
		<body name="'body_armor_throat'">
			<endurance damage="8" explosion="50">
				<run_sequence name="'int_seq_armor_throat'"/>
			</endurance>
		</body>
		<body name="'body_armor_neck'">
			<endurance damage="8" explosion="50">
				<run_sequence name="'int_seq_armor_neck'"/>
			</endurance>
		</body>	
		<variables>
			<var_dozer_var value="2"/>
			<var_helmet_skull 		  value="'units/pd2_dlc_gitgud/characters/ene_zeal_bulldozer_sc/debris/ene_acc_bulldozer_helmet/ene_acc_bulldozer_helmet'"/>			
			<var_helmet_plate_skull   value="'units/pd2_dlc_gitgud/characters/ene_zeal_bulldozer_sc/debris/ene_acc_bulldozer_helmet_plate/ene_acc_bulldozer_helmet_plate'"/>
			<var_neck_skull  		  value="'units/pd2_dlc_gitgud/characters/ene_zeal_bulldozer_sc/debris/ene_acc_bulldozer_neck/ene_acc_bulldozer_neck'"/>
			<var_chest_skull  		  value="'units/pd2_dlc_gitgud/characters/ene_zeal_bulldozer_sc/debris/ene_acc_bulldozer_chest/ene_acc_bulldozer_chest'"/>
			<var_stomache_skull  	  value="'units/pd2_dlc_gitgud/characters/ene_zeal_bulldozer_sc/debris/ene_acc_bulldozer_stomache/ene_acc_bulldozer_stomache'"/>
			<var_back_skull 		  value="'units/pd2_dlc_gitgud/characters/ene_zeal_bulldozer_sc/debris/ene_acc_bulldozer_back/ene_acc_bulldozer_back'"/>
			<!-- GREEN -->
			<var_neck 		  		  value="'units/pd2_dlc_gitgud/characters/ene_zeal_bulldozer_2_sc/debris/ene_acc_bulldozer_neck/ene_acc_bulldozer_neck'"/>
			<var_throat 	 		  value="'units/pd2_dlc_gitgud/characters/ene_zeal_bulldozer_2_sc/debris/ene_acc_bulldozer_throat/ene_acc_bulldozer_throat'"/>
			<var_chest 		  		  value="'units/pd2_dlc_gitgud/characters/ene_zeal_bulldozer_2_sc/debris/ene_acc_bulldozer_chest/ene_acc_bulldozer_chest'"/>
			<var_stomache 	 		  value="'units/pd2_dlc_gitgud/characters/ene_zeal_bulldozer_2_sc/debris/ene_acc_bulldozer_stomache/ene_acc_bulldozer_stomache'"/>
			<var_back 		 		  value="'units/pd2_dlc_gitgud/characters/ene_zeal_bulldozer_2_sc/debris/ene_acc_bulldozer_back/ene_acc_bulldozer_back'"/>			
			<var_helmet		  		  value="'units/pd2_dlc_gitgud/characters/ene_zeal_bulldozer_sc/debris/ene_acc_bulldozer_helmet/ene_acc_bulldozer_helmet'"/>			
			<var_helmet_plate 		  value="'units/pd2_dlc_gitgud/characters/ene_zeal_bulldozer_2_sc/debris/ene_acc_bulldozer_helmet_plate/ene_acc_bulldozer_helmet_plate'"/>
			<!-- BLACK -->
			<var_helmet_black		  value="'units/pd2_dlc_gitgud/characters/ene_acc_zeal_city_1_helmet/ene_acc_zeal_city_1_helmet'"/>			
			<var_helmet_plate_black   value="'units/pd2_dlc_gitgud/characters/ene_zeal_bulldozer_3_sc/debris/ene_acc_bulldozer_helmet_plate/ene_acc_bulldozer_helmet_plate'"/>
			<var_neck_black 		  value="'units/pd2_dlc_gitgud/characters/ene_zeal_bulldozer_3_sc/debris/ene_acc_bulldozer_neck/ene_acc_bulldozer_neck'"/>
			<var_throat_black 	  	  value="'units/pd2_dlc_gitgud/characters/ene_zeal_bulldozer_3_sc/debris/ene_acc_bulldozer_throat/ene_acc_bulldozer_throat'"/>
			<var_chest_black 		  value="'units/pd2_dlc_gitgud/characters/ene_zeal_bulldozer_3_sc/debris/ene_acc_bulldozer_chest/ene_acc_bulldozer_chest'"/>
			<var_stomache_black 	  value="'units/pd2_dlc_gitgud/characters/ene_zeal_bulldozer_3_sc/debris/ene_acc_bulldozer_stomache/ene_acc_bulldozer_stomache'"/>
			<var_back_black 		  value="'units/pd2_dlc_gitgud/characters/ene_zeal_bulldozer_3_sc/debris/ene_acc_bulldozer_back/ene_acc_bulldozer_back'"/>			
			<!-- BEN -->
			<var_helmet_ben		  	  value="'units/pd2_dlc_gitgud/characters/ene_bulldozer_minigun/debris/ene_acc_bulldozer_helmet/ene_acc_bulldozer_helmet'"/>			
			<var_helmet_plate_ben 	  value="'units/pd2_dlc_drm/characters/ene_acc_bulldozer_minigun_helmet_plate/ene_acc_bulldozer_minigun_helmet_plate'"/>
			<var_neck_ben 		  	  value="'units/pd2_dlc_drm/characters/ene_acc_bulldozer_minigun_neck/ene_acc_bulldozer_minigun_neck'"/>
			<var_throat_ben 	 	  value="'units/pd2_dlc_drm/characters/ene_acc_bulldozer_minigun_throat/ene_acc_bulldozer_minigun_throat'"/>
			<var_chest_ben  		  value="'units/pd2_dlc_drm/characters/ene_acc_bulldozer_minigun_chest/ene_acc_bulldozer_minigun_chest'"/>
			<var_stomache_ben  	  	  value="'units/pd2_dlc_drm/characters/ene_acc_bulldozer_minigun_stomache/ene_acc_bulldozer_minigun_stomache'"/>
			<var_back_ben  		      value="'units/pd2_dlc_drm/characters/ene_acc_bulldozer_minigun_back/ene_acc_bulldozer_minigun_back'"/>			
			<!-- MEDIC -->
			<var_helmet_medic		  value="'units/pd2_dlc_drm/characters/ene_bulldozer_medic_sc/debris/ene_acc_bulldozer_helmet/ene_acc_bulldozer_helmet'"/>			
			<var_helmet_plate_medic   value="'units/pd2_dlc_drm/characters/ene_bulldozer_medic_sc/debris/ene_acc_bulldozer_helmet_plate/ene_acc_bulldozer_helmet_plate'"/>
			<var_neck_medic 		  value="'units/pd2_dlc_drm/characters/ene_bulldozer_medic_sc/debris/ene_acc_bulldozer_neck/ene_acc_bulldozer_neck'"/>
			<var_throat_medic 	      value="'units/pd2_dlc_drm/characters/ene_bulldozer_medic_sc/debris/ene_acc_bulldozer_throat/ene_acc_bulldozer_throat'"/>
			<var_chest_medic 		  value="'units/pd2_dlc_drm/characters/ene_bulldozer_medic_sc/debris/ene_acc_bulldozer_chest/ene_acc_bulldozer_chest'"/>
			<var_stomache_medic 	  value="'units/pd2_dlc_drm/characters/ene_bulldozer_medic_sc/debris/ene_acc_bulldozer_stomache/ene_acc_bulldozer_stomache'"/>
			<var_back_medic 		  value="'units/pd2_dlc_drm/characters/ene_bulldozer_medic_sc/debris/ene_acc_bulldozer_back/ene_acc_bulldozer_back'"/>
		</variables>
		<filter name="'check_normal'">
			<check value="vars.var_dozer_var == 0"/>
		</filter>
		<filter name="'check_black'">
			<check value="vars.var_dozer_var == 1"/>
		</filter>
		<filter name="'check_skull'">
			<check value="vars.var_dozer_var == 2"/>
		</filter>
		<filter name="'check_ben'">
			<check value="vars.var_dozer_var == 3"/>
		</filter>		
		<filter name="'check_med'">
			<check value="vars.var_dozer_var == 4"/>
		</filter>
		<sequence editable_state="true" name="'face_g'" once="true" triggable="true">
			<object enabled="true" name="'g_face_g'"/>
			<object enabled="true" name="'g_face_g_lod1'"/>
		</sequence>
		
		<sequence editable_state="true" name="'head_balaclava_a'" triggable="true" once="true">	
			<object enabled="true" name="'g_balaclava_a'"/>
			<object enabled="true" name="'g_balaclava_a_lod1'"/>	
		</sequence>							

		<sequence editable_state="true" name="'head_balaclava_b'" triggable="true" once="true">	
			<object enabled="true" name="'g_balaclava_b'"/>
			<object enabled="true" name="'g_balaclava_b_lod1'"/>	
		</sequence>							

		<sequence editable_state="true" name="'face_a'" once="true" triggable="true">
			<object enabled="true" name="'g_face_a'"/>
			<object enabled="true" name="'g_face_a_lod1'"/>
		</sequence>								
		<sequence editable_state="true" name="'face_b'" once="true" triggable="true">
			<object enabled="true" name="'g_face_b'"/>
			<object enabled="true" name="'g_face_b_lod1'"/>
		</sequence>								
		<sequence editable_state="true" name="'face_c'" once="true" triggable="true">
			<object enabled="true" name="'g_face_c'"/>
			<object enabled="true" name="'g_face_c_lod1'"/>
		</sequence>								
		<sequence editable_state="true" name="'face_d'" once="true" triggable="true">
			<object enabled="true" name="'g_face_d'"/>
			<object enabled="true" name="'g_face_d_lod1'"/>
		</sequence>								
		<sequence editable_state="true" name="'face_e'" once="true" triggable="true">
			<object enabled="true" name="'g_face_e'"/>
			<object enabled="true" name="'g_face_e_lod1'"/>
		</sequence>	
		<sequence editable_state="true" name="'face_f'" once="true" triggable="true">
			<object enabled="true" name="'g_face_f'"/>
			<object enabled="true" name="'g_face_f_lod1'"/>
		</sequence>	
		<sequence editable_state="true" name="'face_g'" once="true" triggable="true">
			<object enabled="true" name="'g_face_g'"/>
			<object enabled="true" name="'g_face_g_lod1'"/>
		</sequence>	

		<sequence name="'select_face'" startup="true" once="true">
			<run_sequence name="'head'..pick('_balaclava_a', '_balaclava_a', '_balaclava_b', '_balaclava_a', '_balaclava_b', '_balaclava_a', '_balaclava_a', '_balaclava_a', '_balaclava_a')"/>
			<run_sequence name="'face'..pick('_a', '_a' , '_c', '_d', '_e', '_b', '_g', '_f')" />
		</sequence>		
		
		<sequence editable_state="true" name="'green'" triggable="true" once="true">
			<set_variables var_dozer_var="0"/>
			<object enabled="false" name="'g_armor_back_skull'"/>

			<object enabled="false" name="'g_dozer_skull'"/>
			<object enabled="false" name="'g_dozer_skull_lod1'"/>
			<object enabled="false" name="'g_armor_chest_skull'"/>
			<object enabled="false" name="'g_throat_skull'"/>
			<object enabled="false" name="'g_throat_skull_lod1'"/>			
			<object enabled="false" name="'g_armor_stomache_skull'"/>

			<object enabled="true" name="'g_swat_sg'"/>
			<object enabled="true" name="'g_swat_sg_lod1'"/>
			<object enabled="true" name="'g_shells_chest'"/>
			<object enabled="true" name="'g_shells_chest_lod1'"/>
			<object enabled="true" name="'g_armor_stomache'"/>
			<object enabled="true" name="'g_armor_stomache_lod1'"/>
			<object enabled="true" name="'g_armor_chest'"/>
			<object enabled="true" name="'g_armor_chest_lod1'"/>

			
			<material_config name="'units/pd2_dlc_gitgud/characters/ene_zeal_bulldozer_2_sc/ene_zeal_bulldozer_2_sc'"/>															
		
		</sequence>
		<sequence editable_state="true" name="'black'" triggable="true" once="true">
			<set_variables var_dozer_var="1"/>
			<body enabled="false" name="'body_helmet'"/>
			<decal_mesh enabled="false" name="'dm_helmet'"/>	
			<body enabled="false" name="'body_helmet_plate'"/>
			<decal_mesh enabled="false" name="'dm_helmet_plate'"/>	

			<object enabled="false" name="'g_dozer_skull'"/>
			<object enabled="false" name="'g_dozer_skull_lod1'"/>
			<object enabled="false" name="'g_armor_chest_skull'"/>
			<object enabled="false" name="'g_neck'"/>
			<object enabled="false" name="'g_helmet_glass'"/>
			<object enabled="false" name="'g_helmet_glass_lod1'"/>
			<object enabled="false" name="'g_throat_skull'"/>
			<object enabled="false" name="'g_throat_skull_lod1'"/>			
			<object enabled="false" name="'g_helmet_plate'"/>
			<object enabled="false" name="'g_helmet_plate_lod1'"/>
			<object enabled="false" name="'g_helmet'"/>
			<object enabled="false" name="'g_helmet_lod1'"/>
			<object enabled="false" name="'g_armor_stomache_skull'"/>
			<object enabled="false" name="'g_body_lod1'"/>	
			<object enabled="false" name="'g_body'"/>	

			<object enabled="true" name="'g_body_black'"/>
			<object enabled="true" name="'g_body_black_lod1'"/>	
			<object enabled="true" name="'g_neck_black'"/>
			<object enabled="true" name="'g_neck_black_lod1'"/>
			<object enabled="true" name="'g_helmet_lod2'"/>
			<object enabled="true" name="'g_helmet_lod3'"/>
			<object enabled="true" name="'g_helmet_plate_lod2'"/>
			<object enabled="true" name="'g_helmet_plate_lod3'"/>
			<object enabled="true" name="'g_helmet_glass_black'"/>
			<object enabled="true" name="'g_helmet_glass_black_lod1'"/>
			<object enabled="true" name="'g_throat_black'"/>			
			<object enabled="true" name="'g_armor_chest_black'"/>
			<object enabled="true" name="'g_armor_stomache_black'"/>
			
			<body enabled="true" name="'body_helmet_black'"/>
			<decal_mesh enabled="true" name="'dm_helmet_black'"/>	
			<body enabled="true" name="'body_helmet_plate_black'"/>
			<decal_mesh enabled="true" name="'dm_helmet_plate_black'"/>	
			
			<object enabled="false" name="'g_armor_back_skull'"/>

			
			<material_config name="'units/pd2_dlc_gitgud/characters/ene_zeal_bulldozer_3_sc/ene_zeal_bulldozer_3_sc'"/>															
		</sequence>						
		
		<sequence editable_state="true" name="'ben'" triggable="true" once="true">
			<set_variables var_dozer_var="3"/>
			<body enabled="false" name="'body_helmet'"/>
			<decal_mesh enabled="false" name="'dm_helmet'"/>	
			<object enabled="false" name="'g_helmet_glass'"/>
			<object enabled="false" name="'g_helmet_glass_lod1'"/>
			
			<body enabled="true" name="'body_helmet_ben'"/>
			<decal_mesh enabled="true" name="'dm_helmet_ben'"/>	
			<object enabled="false" name="'g_armor_back_skull'"/>
			
			<object enabled="true" name="'g_swat_ben'"/>
			<object enabled="true" name="'g_swat_ben_lod1'"/>
			<object enabled="true" name="'g_helmet_glass_ben'"/>
			<object enabled="true" name="'g_helmet_glass_ben_lod1'"/>
			<object enabled="true" name="'g_helmet_ben'"/>
			<object enabled="true" name="'g_helmet_ben_lod1'"/>
			<object enabled="true" name="'g_dozer_shells_ben_chest'"/>
			<object enabled="true" name="'g_dozer_shells_ben_chest_lod1'"/>
			<object enabled="true" name="'g_armor_back_benelli'"/>

			
			<material_config name="'units/pd2_dlc_gitgud/characters/ene_bulldozer_minigun/ene_bulldozer_minigun'"/>															
		
		</sequence>						
		<sequence editable_state="true" name="'medic'" triggable="true" once="true">
			<set_variables var_dozer_var="4"/>			
			<object enabled="false" name="'g_dozer_skull'"/>
			<object enabled="false" name="'g_dozer_skull_lod1'"/>
			<object enabled="false" name="'g_armor_chest_skull'"/>
			<object enabled="false" name="'g_neck'"/>
			<object enabled="false" name="'g_throat_skull'"/>
			<object enabled="false" name="'g_throat_skull_lod1'"/>			
			<object enabled="false" name="'g_armor_stomache_skull'"/>
			<object enabled="false" name="'g_body_lod1'"/>	
			<object enabled="false" name="'g_body'"/>	

			<object enabled="true" name="'g_body_black'"/>
			<object enabled="true" name="'g_body_black_lod1'"/>	
			<object enabled="true" name="'g_neck_black'"/>
			<object enabled="true" name="'g_neck_black_lod1'"/>
			<object enabled="true" name="'g_throat_black'"/>			
			<object enabled="true" name="'g_armor_chest_black'"/>
			<object enabled="true" name="'g_armor_stomache_black'"/>
			
			<material_config name="'units/pd2_dlc_drm/characters/ene_bulldozer_medic_sc/ene_bulldozer_medic_sc'"/>															
		
		</sequence>						
		<sequence name="'int_seq_helmet_plate'" once="true">
			<body enabled="false" name="'body_helmet_plate'"/>
			<body enabled="false" name="'body_helmet_plate_black'"/>
			<object enabled="false" name="'g_helmet_plate'"/>
			<object enabled="false" name="'g_helmet_plate_lod1'"/>
			<object enabled="false" name="'g_helmet_plate_lod2'"/>
			<object enabled="false" name="'g_helmet_plate_lod3'"/>
			<decal_mesh enabled="false" name="'dm_helmet_plate'"/>
			<decal_mesh enabled="false" name="'dm_helmet_plate_black'"/>
			
			<body enabled="true" name="'body_helmet_glass'"/>
			<object enabled="true" name="'g_helmet_glass'"/>
			<object enabled="true" name="'g_helmet_glass_lod1'"/>
			<decal_mesh enabled="true" name="'dm_helmet_glass'"/>
			
			<body filter="'check_black'" enabled="false" name="'body_helmet_glass'"/>
			<object filter="'check_black'" enabled="false" name="'g_helmet_glass'"/>
			<object filter="'check_black'" enabled="false" name="'g_helmet_glass_lod1'"/>
			<decal_mesh filter="'check_black'" enabled="false" name="'dm_helmet_glass'"/>
			<body filter="'check_black'" enabled="true" name="'body_helmet_glass_black'"/>
			<decal_mesh filter="'check_black'" enabled="true" name="'dm_helmet_black_glass'"/>
			
			<body filter="'check_ben'" enabled="false" name="'body_helmet_glass'"/>
			<object filter="'check_ben'" enabled="false" name="'g_helmet_glass'"/>
			<object filter="'check_ben'" enabled="false" name="'g_helmet_glass_lod1'"/>
			<decal_mesh filter="'check_ben'" enabled="false" name="'dm_helmet_glass'"/>
			<body filter="'check_ben'" enabled="true" name="'body_helmet_glass_ben'"/>
			<decal_mesh filter="'check_ben'" enabled="true" name="'dm_helmet_glass_ben'"/>
			
			<spawn_unit filter="'check_skull'" name="vars.var_helmet_plate_skull" position="object_pos('Head')" rotation="object_rot('Head')"/>
			<spawn_unit filter="'check_ben'" 	name="vars.var_helmet_plate_ben" position="object_pos('Head')" rotation="object_rot('Head')"/>
			<spawn_unit filter="'check_black'" 	name="vars.var_helmet_plate_black" position="object_pos('Head')" rotation="object_rot('Head')"/>
			<spawn_unit filter="'check_med'" 	name="vars.var_helmet_plate_medic" position="object_pos('Head')" rotation="object_rot('Head')"/>
			<spawn_unit filter="'check_normal'" name="vars.var_helmet_plate" position="object_pos('Head')" rotation="object_rot('Head')"/>
			<sound action="'play'" event="'bulldozer_metal_plate_shatter'" object="'Head'"/>
		</sequence>
		<sequence name="'int_seq_helmet_glass_01'" once="true">
			<object enabled="false" name="'g_helmet_glass'"/>
			<object enabled="false" name="'g_helmet_glass_lod1'"/>
			<object enabled="false" name="'g_helmet_glass_black'"/>
			<object enabled="true" name="'g_helmet_glass_crk'"/>
			<object enabled="true" name="'g_helmet_glass_crk_lod1'"/>
			
			<object filter="'check_black'" enabled="false" name="'g_helmet_glass_crk'"/>
			<object filter="'check_black'" enabled="false" name="'g_helmet_glass_crk_lod1'"/>
			<object filter="'check_black'" enabled="true" name="'g_helmet_glass_black_crk'"/>
			
			<object filter="'check_ben'" enabled="false" name="'g_helmet_glass_crk'"/>
			<object filter="'check_ben'" enabled="false" name="'g_helmet_glass_crk_lod1'"/>
			<object filter="'check_ben'" enabled="false" name="'g_helmet_glass'"/>
			<object filter="'check_ben'" enabled="false" name="'g_helmet_glass_lod1'"/>
			<object filter="'check_ben'" enabled="false" name="'g_helmet_glass_ben'"/>
			<object filter="'check_ben'" enabled="false" name="'g_helmet_glass_ben_lod1'"/>
			<object filter="'check_ben'" enabled="true" name="'g_helmet_glass_ben_crk'"/>
			<object filter="'check_ben'" enabled="true" name="'g_helmet_glass_ben_crk_lod1'"/>
			
		</sequence>
		<sequence name="'int_seq_helmet_glass_02'" once="true">
			<sound action="'play'" event="'bulldozer_visor_shatter'" object="'Head'"/>
			<body enabled="true" name="'head'"/>
			<body enabled="false" name="'body_helmet_glass'"/>
			<body enabled="false" name="'body_helmet'"/>
			<body enabled="false" name="'body_helmet_glass_ben'"/>
			<body enabled="false" name="'body_helmet_glass_black'"/>
			<body enabled="false" name="'body_helmet_ben'"/>
			<body enabled="false" name="'body_helmet_black'"/>
			
			<object enabled="false" name="'g_helmet_glass'"/>
			<object enabled="false" name="'g_helmet_glass_contour'"/>
			<object enabled="false" name="'g_helmet_glass_lod1'"/>
			<object enabled="false" name="'g_helmet_glass_crk'"/>
			<object enabled="false" name="'g_helmet_glass_crk_lod1'"/>
			<object enabled="false" name="'g_helmet_glass_ben_crk'"/>
			<object enabled="false" name="'g_helmet_glass_ben_crk_lod1'"/>
			<object enabled="false" name="'g_helmet_glass_black_crk'"/>
			<decal_mesh enabled="false" name="'dm_helmet_glass'"/>
			<decal_mesh enabled="false" name="'dm_helmet_black_glass'"/>
			<decal_mesh enabled="false" name="'dm_helmet_glass_ben'"/>
			<decal_mesh enabled="true" name="'dm_head'"/>
			<effect damp_time="4" name="'effects/particles/bullet_hit/glass_breakable/bullet_hit_glass_breakable'" parent="object( 'e_glass' )" position="v()"/>
			<effect damp_time="5" name="'effects/particles/bullet_hit/glass_breakable/bullet_hit_glass_breakable'" parent="object( 'e_glass' )" position="v()"/>
			<function extension="'character_damage'" function="'seq_clbk_vizor_shatter'" start_time="1"/>
		</sequence>
		<sequence name="'int_seq_helmet_pop'" once="true">
			<sound action="'play'" event="'bulldozer_metal_plate_shatter'" object="'Head'"/>		
			<sound action="'play'" event="'knife_equip'" object="'Head'"/>
			<sound action="'play'" event="'knife_hit_gen'" object="'Head'"/>
			<sound action="'play'" event="'knuckles_hit_gen'" object="'Head'"/>
			<sound action="'play'" event="'knuckles_hit_gen'" object="'Head'"/>
			<object enabled="false" name="'g_helmet'"/>
			<object enabled="false" name="'g_helmet_ben'"/>
			<object enabled="false" name="'g_helmet_ben_lod1'"/>
			<object enabled="false" name="'g_helmet_lod1'"/>
			<object enabled="false" name="'g_helmet_lod2'"/>
			<object enabled="false" name="'g_helmet_lod3'"/>
			<decal_mesh enabled="false" name="'dm_helmet'"/>			
			<decal_mesh enabled="false" name="'dm_helmet_ben'"/>			
			<decal_mesh enabled="false" name="'dm_helmet_black'"/>			
			<spawn_unit filter="'check_normal'" name="vars.var_helmet" position="object_pos('Head')" rotation="object_rot('Head')" transfer_ang_velocity="v( 50 * rand(), 50 * rand(), 500 * rand() )" transfer_velocity="v( 0, 450 * rand(), 650 * rand() )"/>
			<spawn_unit filter="'check_black'" name="vars.var_helmet_black" position="object_pos('Head')" rotation="object_rot('Head')" transfer_ang_velocity="v( 50 * rand(), 50 * rand(), 500 * rand() )" transfer_velocity="v( 0, 450 * rand(), 650 * rand() )"/>
			<spawn_unit filter="'check_ben'" name="vars.var_helmet_ben" position="object_pos('Head')" rotation="object_rot('Head')" transfer_ang_velocity="v( 50 * rand(), 50 * rand(), 500 * rand() )" transfer_velocity="v( 0, 450 * rand(), 650 * rand() )"/>
			<spawn_unit filter="'check_skull'" name="vars.var_helmet_skull" position="object_pos('Head')" rotation="object_rot('Head')" transfer_ang_velocity="v( 50 * rand(), 50 * rand(), 500 * rand() )" transfer_velocity="v( 0, 450 * rand(), 650 * rand() )"/>
			<spawn_unit filter="'check_med'" name="vars.var_helmet_medic" position="object_pos('Head')" rotation="object_rot('Head')" transfer_ang_velocity="v( 50 * rand(), 50 * rand(), 500 * rand() )" transfer_velocity="v( 0, 450 * rand(), 650 * rand() )"/>
		</sequence>
		<sequence name="'int_seq_armor_chest'" once="true">
			<body enabled="false" name="'body_armor_chest'"/>
