			<object filter="'check_blue_taser'" enabled="true" name="'g_explosivebag_t'"/>												
			<object filter="'check_blue_taser'" enabled="true" name="'g_taser'"/>	
			<object filter="'check_blue_taser'" enabled="true" name="'g_taser_lod1'"/>
			<run_sequence filter="'check_blue_taser'" name="'heavy_helmet_d'"/>		
			<run_sequence filter="'check_blue_taser'" name="'holster_'..pick('l', fuck)"/>
			<run_sequence filter="'check_blue_taser'" name="'body_'..pick('longsleeve', 'longsleeve', 'nothing')"/>
			<run_sequence filter="'check_blue_taser'" name="'goggles_'..pick('a','a','b')"/>								
