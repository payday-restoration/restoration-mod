			<object filter="'check_blue_sniper'" enabled="false" name="'g_helmet_lod1'"/>						
			<object filter="'check_blue_sniper'" enabled="false" name="'g_helmet_lod2'"/>
			<object filter="'check_blue_sniper'" enabled="true" name="'g_headset'"/>						
			<object filter="'check_blue_sniper'" enabled="true" name="'g_headset_lod1'"/>
			<object filter="'check_blue_sniper'" enabled="true" name="'g_hat_lod1'"/>						
			<object filter="'check_blue_sniper'" enabled="true" name="'g_hat_lod2'"/>
